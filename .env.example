# Copy to `.env` and adjust as needed:
#   cp .env.example .env
#
# Requires Docker Compose v2 (v2.24+ recommended).
# If BuildKit/Bake fails: COMPOSE_BAKE=false DOCKER_BUILDKIT=0 docker compose up --build
#
# Keep host ports and browser wiring aligned:
#   - If you change API_PORT, also update VITE_API_BASE_URL and rebuild the UI image.
#   - If you change UI_PORT, also update CORS_ORIGIN_0 / CORS_ORIGIN_1.

# --- Postgres ---
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me
# Host port; change if you already run Postgres on 5432 locally.
POSTGRES_PORT=5432

# --- Published ports on the host ---
API_PORT=5012
UI_PORT=5173

# --- CORS (browser origin for atlas.ui) — must match UI_PORT ---
CORS_ORIGIN_0=http://localhost:5173
CORS_ORIGIN_1=http://127.0.0.1:5173

# --- UI build-time API URL (browser calls the host-mapped API) — must match API_PORT ---
# Rebuild the ui service after changing this value.
VITE_API_BASE_URL=http://localhost:5012

# --- Azure DevOps (optional) ---
# Leave empty for local CRUD without Azure sync/import.
AzureDevopsToken=

# --- OpenAI (required for AI features) ---
# Without this key, core CRUD still works; AI panel shows setup guidance.
OpenAI__ApiKey=
OpenAI__Model=gpt-4.1-mini
OpenAI__BaseUrl=https://api.openai.com/v1

# --- AI limits (optional overrides) ---
Ai__MaxPromptChars=4000
Ai__MaxContextChars=12000
Ai__MaxConcurrentSessions=4

# --- Demo seed (optional; prefer Compose profile instead) ---
# Prefer: docker compose --profile demo up --build
# Or set true to seed from the API process itself:
ATLAS_SEED_DEMO=false
