@implements IAsyncDisposable

@if (this._ai.IsOpen)
{
    <aside class="aiPanel" aria-label="AI panel">
        <div class="aiPanelHeader">
            <div class="aiPanelTitle">@this._ai.ContextTitle</div>
            <div class="aiPanelHeaderActions">
                <button class="btn btnSecondary"
                        type="button"
                        disabled="@(!CanInsertDraft)"
                        title="@InsertDraftTitle"
                        @onclick="HandleInsertDraft">
                    Insert Draft
                </button>
                <button class="btn btnGhost" type="button" disabled="@this._ai.IsRunning" @onclick="StartNewSessionAsync">
                    New session
                </button>
                <button class="btn btnGhost" type="button" @onclick="this._ai.ClearOutput">Clear</button>
                <button class="btn btnGhost" type="button" @onclick="() => this._ai.SetIsOpen(false)">Close</button>
            </div>
        </div>

        <div class="aiPanelBody">
            <div class="aiPanelMeta">
                <div class="mutedSmall">
                    Status: @this._ai.Status@(this._ai.IsRunning ? " (running)" : "")@(this._ai.ActiveConversationId is not null ? " · In conversation" : "")
                </div>
                @if (this._ai.ContextSupportMessage is not null)
                {
                    <div class="mutedSmall">@this._ai.ContextSupportMessage</div>
                }
                @if (!this._ai.HasDraftTarget)
                {
                    <div class="mutedSmall">Insert Draft: edit a task note or note body first</div>
                }
                @if (!string.IsNullOrEmpty(this._ai.Notice))
                {
                    <div class="aiPanelNotice">@this._ai.Notice</div>
                }
            </div>

            @if (ShowOpenAiSetup)
            {
                <div class="aiPanelSetupGuide" role="status">
                    <div class="aiPanelSetupTitle">OpenAI API key required</div>
                    <div class="mutedSmall">Atlas AI needs an OpenAI key. Configure one of these, then restart the API:</div>
                    <ul class="aiPanelSetupList">
                        <li>Environment variable: <code>OpenAI__ApiKey</code></li>
                        <li>
                            User secrets in the Atlas.Api project:
                            <code>dotnet user-secrets set "OpenAI:ApiKey" "&lt;key&gt;"</code>
                        </li>
                        <li>Compose <code>.env</code>: <code>OpenAI__ApiKey=...</code></li>
                    </ul>
                </div>
            }

            <div @ref="this.ScrollRef" class="aiPanelScroll" role="log" aria-label="AI conversation" aria-live="polite">
                @if (this._ai.Turns.Count == 0)
                {
                    <div class="aiPanelEmpty muted">Ask a question or choose an action to get started.</div>
                }
                else
                {
                    @for (var i = 0; i < this._ai.Turns.Count; i++)
                    {
                        AiTranscriptTurn turn = this._ai.Turns[i];
                        bool isLast = i == this._ai.Turns.Count - 1;
                        bool isThinking = isLast && this._ai.IsRunning && string.IsNullOrWhiteSpace(turn.Response);
                        <article class="aiPanelTurn" @key="turn.Id">
                            <div class="aiPanelTurnPrompt">@turn.Prompt</div>
                            <div class="aiPanelTurnResponse">
                                @if (isThinking)
                                {
                                    <div class="aiPanelThinking muted">Thinking…</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(turn.Response))
                                {
                                    <MarkdownBlock Text="@turn.Response" />
                                    <button type="button"
                                            class="btn btnGhost btnIcon aiPanelCopyBtn@(this.CopiedTurnId == turn.Id ? " aiPanelCopyBtnCopied" : null)"
                                            title="@(this.CopiedTurnId == turn.Id ? "Copied" : "Copy response")"
                                            aria-label="@(this.CopiedTurnId == turn.Id ? "Copied" : "Copy response")"
                                            @onclick="() => CopyTurnResponse(turn)">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                            <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                                            <path d="M4 11H3.5A1.5 1.5 0 0 1 2 9.5v-7A1.5 1.5 0 0 1 3.5 1H10.5A1.5 1.5 0 0 1 12 2.5V3" stroke="currentColor" stroke-width="1.5" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        </article>
                    }
                }
            </div>

            @if (this._ai.Actions.Count > 0)
            {
                <div class="aiPanelQuickActions">
                    @foreach (AiAction action in this._ai.Actions)
                    {
                        <button @key="action.Id"
                                class="btn btnSecondary"
                                type="button"
                                disabled="@(this._ai.IsRunning || !this._ai.IsContextSupported)"
                                @onclick="() => this._ai.RunAction(action.Id)">
                            @action.Label
                        </button>
                    }
                </div>
            }

            <div class="aiPanelComposer">
                <textarea class="textarea aiPanelPrompt"
                          value="@this._ai.PromptDraft"
                          @oninput="OnPromptInput"
                          placeholder="Ask AI about this context..."
                          rows="3"></textarea>
                <button class="btn aiPanelSend"
                        type="button"
                        disabled="@(this._ai.IsRunning || !this._ai.IsContextSupported || string.IsNullOrWhiteSpace(this._ai.PromptDraft))"
                        @onclick="SendPrompt">
                    Send Prompt
                </button>
            </div>

            @if (this._ai.Conversations.Count > 0)
            {
                <div class="aiPanelHistory">
                    <label class="aiPanelHistoryLabel mutedSmall" for="ai-conversation-select">Conversations</label>
                    <div class="aiPanelHistoryRow">
                        <select id="ai-conversation-select"
                                class="input aiPanelHistorySelect"
                                value="@(this._ai.ActiveConversationId?.ToString() ?? "")"
                                disabled="@(this._ai.IsLoadingHistory || this._ai.IsRunning)"
                                @onchange="OnConversationChange">
                            <option value="">Recent conversations…</option>
                            @foreach (AiConversationListItem conversation in this._ai.Conversations)
                            {
                                string id = conversation.ConversationId.ToString();
                                string updated = conversation.UpdatedAtUtc?.LocalDateTime.ToString() ?? "";
                                string turns = conversation.TurnCount is > 1 ? $" ({conversation.TurnCount} turns)" : "";
                                <option value="@id">@updated — @conversation.Title@turns</option>
                            }
                        </select>
                        <button class="btn btnSecondary aiPanelHistoryRefresh"
                                type="button"
                                disabled="@this._ai.IsLoadingHistory"
                                @onclick="this._ai.LoadConversations">
                            Refresh
                        </button>
                    </div>
                </div>
            }
        </div>
    </aside>
}
