<section class="tasksDetailRow" aria-label="Task detail editor">
    @if (Task is null)
    {
        <div class="card pad"><div class="muted">Task not found.</div></div>
    }
    else
    {
        AtlasTask task = Task;
        string statusLabel = DisplayLabels.FormatTaskStatus(task.Status);
        bool stale = (DisplayLabels.DaysSince(task.LastTouchedIso) ?? 0) >= StaleDays;
        string? assigneeName = AssigneeName(task.AssigneeId);
        Duration.ParsedDuration? estimateParsed = Duration.ParseDurationText(task.EstimatedDurationText);
        string estimatePreview = estimateParsed is null ? "Invalid" : Duration.FormatDurationFromMinutes(estimateParsed.TotalMinutes);
        Duration.ParsedDuration? actualParsed = Duration.ParseDurationText(task.ActualDurationText);
        string actualPreview = actualParsed is not null
            ? Duration.FormatDurationFromMinutes(actualParsed.TotalMinutes)
            : (string.IsNullOrWhiteSpace(task.ActualDurationText) ? "—" : "Invalid");
        IReadOnlyList<AtlasTask> visibleBlockers = GetVisibleBlockers(task);
        IReadOnlyList<AtlasTask> blockerCandidates = GetBlockerCandidates(task);
        HashSet<Guid> tasksThatDependOnMe = GetTasksThatDependOnMe(task.Id);
        bool hasCycle = task.DependencyTaskIds.Any(id => tasksThatDependOnMe.Contains(id));
        Guid? resolvedBlockerId = ResolveBlockerIdFromInput(_addBlockerText, blockerCandidates);

        <div class="card pad">
            <div class="detailHeader">
                <div>
                    <div class="detailTitle">Task Detail</div>
                    <div class="mutedSmall">
                        Last touched: @DisplayLabels.FormatDateTime(task.LastTouchedIso)@(stale ? " • stale" : "")
                        @if (!string.IsNullOrEmpty(SaveStateLabel))
                        {
                            <text> • @SaveStateLabel</text>
                        }
                    </div>
                </div>
                <div class="rowTiny">
                    @if (!_editing)
                    {
                        <div class="pillRow">
                            <span class="pill @Tones.TaskStatusTone(task.Status)">@statusLabel</span>
                            <span class="pill @Tones.PriorityTone(task.Priority)">@task.Priority</span>
                            @if (!string.IsNullOrEmpty(assigneeName))
                            {
                                <span class="pill toneNeutral">Assignee: @assigneeName</span>
                            }
                        </div>
                    }
                    <button class="btn btnGhost" type="button" @onclick="ToggleEdit">@(_editing ? "Done" : "Edit")</button>
                    <button class="btn btnGhost textBad" type="button" @onclick="HandleDelete" disabled="@_deleting">
                        @(_deleting ? "Deleting…" : "Delete")
                    </button>
                    @if (IsFocusMode)
                    {
                        <button class="btn btnGhost" type="button" @onclick="OnExitFocus">Exit focus</button>
                    }
                    else
                    {
                        <button class="btn btnGhost" type="button" @onclick="OnClose">Close</button>
                        <button class="btn btnGhost" type="button" @onclick="OnEnterFocus">Focus</button>
                    }
                </div>
            </div>

            <div class="fieldGrid2">
                @if (_editing)
                {
                    <label class="field span2">
                        <div class="fieldLabel">Title</div>
                        <input class="input" value="@task.Title" @oninput="OnTitleInput" />
                    </label>
                }
                else
                {
                    <div class="field span2">
                        <div class="fieldLabel">Title</div>
                        <div class="noteDetailReadonly">@(string.IsNullOrEmpty(task.Title) ? "—" : task.Title)</div>
                    </div>
                }

                <div class="field">
                    <div class="fieldLabel">Status</div>
                    @if (_editing)
                    {
                        <select class="select" value="@statusLabel" @onchange="OnStatusChange">
                            <option value="Not Started">Not Started</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Blocked">Blocked</option>
                            <option value="Done">Done</option>
                        </select>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">
                            <span class="pill @Tones.TaskStatusTone(task.Status)">@statusLabel</span>
                        </div>
                    }
                </div>

                <div class="field">
                    <div class="fieldLabel">Priority (required)</div>
                    @if (_editing)
                    {
                        <select class="select" value="@task.Priority.ToString()" @onchange="OnPriorityChange">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </select>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@task.Priority</div>
                    }
                </div>

                <div class="field">
                    <div class="fieldLabel">Assignee (optional)</div>
                    @if (_editing)
                    {
                        <select class="select" value="@(task.AssigneeId?.ToString() ?? "")" @onchange="OnAssigneeChange">
                            <option value="">(None)</option>
                            @foreach (TeamMember m in AssigneeOptions)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                            @if (task.AssigneeId is not null && !MemberById.ContainsKey(task.AssigneeId.Value))
                            {
                                <option value="@task.AssigneeId">@task.AssigneeId (unknown)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@(assigneeName ?? "—")</div>
                    }
                </div>

                <div class="field">
                    <div class="fieldLabel">Estimated Duration (required)</div>
                    @if (_editing)
                    {
                        <input class="input" placeholder="e.g., 1d, 2h30m" value="@task.EstimatedDurationText" @oninput="OnEstimateInput" />
                        <div class="mutedSmall @(estimateParsed is null ? "textBad" : null)">Estimated: @estimatePreview</div>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@(string.IsNullOrEmpty(task.EstimatedDurationText) ? "—" : task.EstimatedDurationText)</div>
                        <div class="mutedSmall @(estimateParsed is null ? "textBad" : null)">Estimated: @estimatePreview</div>
                    }
                </div>

                <div class="field">
                    <div class="fieldLabel">Confidence</div>
                    @if (_editing)
                    {
                        <select class="select" value="@task.EstimateConfidence.ToString()" @onchange="OnConfidenceChange">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@task.EstimateConfidence</div>
                    }
                </div>

                <div class="field">
                    <div class="fieldLabel">Project (optional)</div>
                    @if (_editing)
                    {
                        <select class="select" value="@(task.ProjectId?.ToString() ?? "")" @onchange="OnProjectChange">
                            <option value="">(None)</option>
                            @foreach (Project p in ProjectOptions)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                            @if (task.ProjectId is not null && ProjectOptions.All(p => p.Id != task.ProjectId))
                            {
                                <option value="@task.ProjectId">@(task.Project ?? task.ProjectId.ToString())</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@(task.Project ?? "—")</div>
                    }
                </div>

                <div class="field">
                    <div class="fieldLabel">Risk (optional)</div>
                    @if (_editing)
                    {
                        <select class="select" value="@(task.RiskId?.ToString() ?? "")" @onchange="OnRiskChange">
                            <option value="">(None)</option>
                            @foreach (Risk r in RiskOptions)
                            {
                                <option value="@r.Id">@r.Title</option>
                            }
                            @if (task.RiskId is not null && RiskOptions.All(r => r.Id != task.RiskId))
                            {
                                <option value="@task.RiskId">@(task.Risk ?? task.RiskId.ToString())</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@(task.Risk ?? "—")</div>
                    }
                </div>

                <div class="field">
                    <div class="fieldLabel">Due date (optional)</div>
                    @if (_editing)
                    {
                        <input class="input" type="date" value="@(task.DueDate ?? "")" @onchange="OnDueDateChange" />
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@(task.DueDate ?? "—")</div>
                    }
                </div>

                <div class="field span2">
                    <div class="fieldLabel">Actual Duration (optional)</div>
                    @if (_editing)
                    {
                        <input class="input" placeholder="e.g., 1d2h, 45m" value="@(task.ActualDurationText ?? "")" @oninput="OnActualInput" />
                        <div class="mutedSmall @(task.ActualDurationText is not null && !string.IsNullOrWhiteSpace(task.ActualDurationText) && actualParsed is null ? "textBad" : null)">Actual: @actualPreview</div>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@(string.IsNullOrWhiteSpace(task.ActualDurationText) ? "—" : task.ActualDurationText)</div>
                        <div class="mutedSmall @(task.ActualDurationText is not null && !string.IsNullOrWhiteSpace(task.ActualDurationText) && actualParsed is null ? "textBad" : null)">Actual: @actualPreview</div>
                    }
                </div>

                <div class="field span2">
                    <div class="fieldLabel">Blockers (optional)</div>
                    <div class="card tight blockersCard">
                        @if (_editing)
                        {
                            <div class="blockersAddRow">
                                <input class="input blockersAddSelect"
                                       list="blockerCandidatesList"
                                       placeholder="Add blocker…"
                                       value="@_addBlockerText"
                                       @oninput="OnAddBlockerInput" />
                                <datalist id="blockerCandidatesList">
                                    @foreach (AtlasTask candidate in blockerCandidates)
                                    {
                                        bool disabled = tasksThatDependOnMe.Contains(candidate.Id);
                                        var label = $"{candidate.Title}{(string.IsNullOrEmpty(candidate.Project) ? "" : $" • {candidate.Project}")}{(disabled ? " • (would create cycle)" : "")} [{candidate.Id}]";
                                        <option value="@label"></option>
                                    }
                                </datalist>
                                <button type="button"
                                        class="btn btnSecondary"
                                        disabled="@(resolvedBlockerId is null || tasksThatDependOnMe.Contains(resolvedBlockerId.Value))"
                                        @onclick="AddBlocker">
                                    Add
                                </button>
                            </div>
                        }

                        <div class="blockersList" role="list" aria-label="Blockers">
                            @if (visibleBlockers.Count == 0)
                            {
                                <div class="mutedSmall">No active blockers.</div>
                            }
                            @foreach (AtlasTask blocker in visibleBlockers)
                            {
                                string blockerStatus = DisplayLabels.FormatTaskStatus(blocker.Status);
                                var suffix = $"{(string.IsNullOrEmpty(blocker.Project) ? "" : $" • {blocker.Project}")}{(string.IsNullOrEmpty(blocker.Risk) ? "" : $" • Risk: {blocker.Risk}")}";
                                <div class="blockersItem" role="listitem">
                                    <div class="blockersItemText">
                                        <div class="blockersItemTitle">@blocker.Title</div>
                                        <div class="blockersItemMeta">@suffix</div>
                                    </div>
                                    <div class="blockersItemRight">
                                        <span class="pill @Tones.TaskStatusTone(blocker.Status)">@blockerStatus</span>
                                        @if (_editing)
                                        {
                                            <button type="button"
                                                    class="btn btnGhost blockersRemoveBtn"
                                                    title="Remove blocker"
                                                    @onclick="() => RemoveBlocker(blocker.Id)">
                                                Remove
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    @if (hasCycle)
                    {
                        <div class="mutedSmall textBad">One or more selected dependencies would create a cycle; please remove them.</div>
                    }
                    @if (_editing && task.DependencyTaskIds.Count > 0)
                    {
                        <div class="rowTiny">
                            <button type="button" class="btn btnGhost" @onclick="ClearDependencies">Clear dependencies</button>
                        </div>
                    }
                </div>

                <div class="field span2">
                    <div class="fieldLabel">Notes</div>
                    @if (_editing)
                    {
                        <textarea class="textarea textareaAutoGrow"
                                  value="@task.Notes"
                                  @oninput="OnNotesInput"></textarea>
                    }
                    else
                    {
                        <div class="noteDetailReadonly" style="white-space: pre-wrap">
                            @(string.IsNullOrWhiteSpace(task.Notes) ? "—" : task.Notes)
                        </div>
                    }
                </div>
            </div>

            <div class="row">
                <button class="btn" type="button" @onclick="TouchTask">Touch / Update Activity</button>
            </div>
        </div>
    }
</section>
