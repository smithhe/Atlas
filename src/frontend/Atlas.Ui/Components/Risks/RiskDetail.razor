<section class="risksDetailRow" aria-label="Risk detail editor">
    @if (Risk is null)
    {
        <div class="card pad"><div class="muted">Risk not found.</div></div>
    }
    else
    {
        Risk risk = Risk;
        IReadOnlyList<AtlasTask> linkedTasks = GetLinkedTasks(risk);
        IReadOnlyList<TeamMember> linkedMembers = GetLinkedMembers(risk);
        IReadOnlyList<TeamMember> teamMemberOptions = this._cache.Team.OrderBy(m => m.Name).ToList();
        IReadOnlyList<RiskHistoryEntry> historyNewestFirst = risk.History
            .OrderByDescending(h => h.CreatedIso)
            .ToList();
        RiskHistoryEntry? selectedHistory = this.SelectedHistoryId is null
            ? null
            : risk.History.FirstOrDefault(h => h.Id == this.SelectedHistoryId);

        <div class="card pad riskDetailCard">
            <div class="riskDetailHeader">
                <div class="riskDetailHeaderTop">
                    <div class="riskDetailTitle">@(string.IsNullOrEmpty(risk.Title) ? "Risk Detail" : risk.Title)</div>
                    @if (!string.IsNullOrEmpty(SaveStateLabel))
                    {
                        <div class="mutedSmall">@SaveStateLabel</div>
                    }
                    <div class="riskDetailHeaderRight">
                        @if (!this.Editing)
                        {
                            <div class="pillRow">
                                <span class="pill @Tones.RiskStatusTone(risk.Status)">@risk.Status</span>
                                <span class="pill @Tones.SeverityTone(risk.Severity)">@risk.Severity</span>
                            </div>
                        }
                        <div class="rowTiny">
                            <button class="btn btnGhost" type="button" @onclick="this.ToggleEdit">@(this.Editing ? "Done" : "Edit")</button>
                            <button class="btn btnGhost textBad" type="button" @onclick="this.HandleDelete" disabled="@this.Deleting">
                                @(this.Deleting ? "Deleting…" : "Delete")
                            </button>
                            @if (this.IsFocusMode)
                            {
                                <button class="btn btnGhost" type="button" @onclick="this.OnExitFocus">Exit focus</button>
                            }
                            else
                            {
                                <button class="btn btnGhost" type="button" @onclick="this.OnClose">Close</button>
                                <button class="btn btnGhost" type="button" @onclick="this.OnEnterFocus">Focus</button>
                            }
                        </div>
                    </div>
                </div>
                <div class="mutedSmall">Last updated: @DisplayLabels.FormatDateTime(risk.LastUpdatedIso)</div>
            </div>

            <div class="fieldGrid2">
                @if (this.Editing)
                {
                    <label class="field span2">
                        <div class="fieldLabel">Title</div>
                        <input class="input" value="@risk.Title" @oninput="this.OnTitleInput" />
                    </label>

                    <label class="field">
                        <div class="fieldLabel">Status</div>
                        <select class="select" value="@risk.Status.ToString()" @onchange="this.OnStatusChange">
                            <option value="Open">Open</option>
                            <option value="Watching">Watching</option>
                            <option value="Resolved">Resolved</option>
                        </select>
                    </label>

                    <label class="field">
                        <div class="fieldLabel">Severity</div>
                        <select class="select" value="@risk.Severity" @onchange="this.OnSeverityChange">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </label>
                }

                <div class="field">
                    <div class="fieldLabel">Project</div>
                    @if (this.Editing)
                    {
                        <select class="select" value="@(risk.ProjectId?.ToString() ?? "")" @onchange="this.OnProjectChange">
                            <option value="">(None)</option>
                            @foreach (Project p in this.ProjectOptions)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                            @if (risk.ProjectId is not null && this.ProjectOptions.All(p => p.Id != risk.ProjectId))
                            {
                                <option value="@risk.ProjectId">@(risk.Project ?? risk.ProjectId.ToString())</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@(risk.Project ?? "—")</div>
                    }
                </div>

                <div class="field span2">
                    <div class="fieldLabel">Description</div>
                    @if (this.Editing)
                    {
                        <textarea class="textarea" value="@risk.Description" @oninput="this.OnDescriptionInput"></textarea>
                    }
                    else
                    {
                        <div class="riskDetailMarkdown riskDetailMarkdownBlock riskDetailDescriptionBlock">
                            @if (string.IsNullOrWhiteSpace(risk.Description))
                            {
                                <div class="muted">—</div>
                            }
                            else
                            {
                                <MarkdownBlock Text="@risk.Description" />
                            }
                        </div>
                    }
                </div>

                <div class="field span2">
                    <div class="fieldLabel">Evidence / Examples</div>
                    @if (this.Editing)
                    {
                        <textarea class="textarea" value="@risk.Evidence" @oninput="this.OnEvidenceInput"></textarea>
                    }
                    else
                    {
                        <div class="riskDetailMarkdown riskDetailMarkdownBlock riskDetailEvidenceBlock">
                            @if (string.IsNullOrWhiteSpace(risk.Evidence))
                            {
                                <div class="muted">—</div>
                            }
                            else
                            {
                                <MarkdownBlock Text="@risk.Evidence" />
                            }
                        </div>
                    }
                </div>

                <div class="field span2">
                    <div class="risksLinkedGrid">
                        <div class="field">
                            <div class="fieldLabel">Linked Tasks</div>
                            <div class="list listCard risksLinkedListCard">
                                @if (linkedTasks.Count == 0)
                                {
                                    <div class="muted pad">No linked tasks yet.</div>
                                }
                                else
                                {
                                    @foreach (AtlasTask t in linkedTasks)
                                    {
                                        <button @key="t.Id" type="button" class="listRow listRowBtn" @onclick="() => GoTask(t.Id)">
                                            <span class="dot dot-@t.Priority.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                                            <div class="listMain">
                                                <div class="listTitle">@t.Title</div>
                                                <div class="listMeta">
                                                    @t.Priority
                                                    @if (!string.IsNullOrEmpty(t.Project)) { <text> • @t.Project</text> }
                                                    @if (!string.IsNullOrEmpty(t.DueDate)) { <text> • Due @t.DueDate</text> }
                                                </div>
                                            </div>
                                        </button>
                                    }
                                }
                            </div>
                        </div>

                        <div class="field">
                            <div class="fieldLabel">Linked Team Members</div>
                            @if (this.Editing)
                            {
                                <div class="list listCard risksLinkedListCard">
                                    @if (teamMemberOptions.Count == 0)
                                    {
                                        <div class="muted pad">
                                            Import team members from Azure DevOps first (
                                            <a class="crumbLink" href="/settings/azure-import">Settings → Azure Import</a>
                                            ).
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (TeamMember m in teamMemberOptions)
                                        {
                                            bool linked = risk.LinkedTeamMemberIds.Contains(m.Id);
                                            <label @key="m.Id" class="listRow" style="cursor: pointer">
                                                <input type="checkbox"
                                                       checked="@linked"
                                                       @onchange="e => OnTeamMemberToggle(m.Id, e)" />
                                                <span class="dot dot-@m.StatusDot.ToLowerInvariant()" aria-hidden="true"></span>
                                                <div class="listMain">
                                                    <div class="listTitle">@m.Name</div>
                                                    <div class="listMeta">
                                                        @(m.Role ?? "Team member")@(string.IsNullOrEmpty(m.CurrentFocus) ? "" : $" • {m.CurrentFocus}")
                                                    </div>
                                                </div>
                                            </label>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="list listCard risksLinkedListCard">
                                    @if (linkedMembers.Count == 0)
                                    {
                                        <div class="muted pad">No linked team members yet.</div>
                                    }
                                    else
                                    {
                                        @foreach (TeamMember m in linkedMembers)
                                        {
                                            <button @key="m.Id" type="button" class="listRow listRowBtn" @onclick="() => GoTeamMember(m.Id)">
                                                <span class="dot dot-@m.StatusDot.ToLowerInvariant()" aria-hidden="true"></span>
                                                <div class="listMain">
                                                    <div class="listTitle">@m.Name</div>
                                                    <div class="listMeta">
                                                        @(m.Role ?? "Team member")@(string.IsNullOrEmpty(m.CurrentFocus) ? "" : $" • {m.CurrentFocus}")
                                                    </div>
                                                </div>
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="field span2">
                    <div class="fieldLabel">Notes / History</div>
                    <div class="row mt-sm">
                        <button class="btn btnSecondary" type="button" @onclick="this.ToggleAddingNote">
                            @(this.IsAddingNote ? "Cancel" : "Add note")
                        </button>
                    </div>

                    @if (this.IsAddingNote)
                    {
                        <div class="mt-sm">
                            <label class="field">
                                <div class="fieldLabel">New note</div>
                                <textarea class="textarea"
                                          placeholder="Write a note (Markdown supported)…"
                                          value="@this.NewNoteText"
                                          @oninput="this.OnNewNoteInput"></textarea>
                            </label>
                            <div class="row mt-sm">
                                <button class="btn btnSecondary" type="button" @onclick="this.AddNote">Add</button>
                            </div>
                        </div>
                    }

                    <div class="mt-md">
                        @if (historyNewestFirst.Count == 0)
                        {
                            <div class="muted">No history yet.</div>
                        }
                        else
                        {
                            <div class="list listCard">
                                @foreach (RiskHistoryEntry h in historyNewestFirst)
                                {
                                    Guid historyId = h.Id;
                                    <button @key="historyId"
                                            type="button"
                                            class="listRow listRowBtn"
                                            @onclick="() => OpenHistoryNote(historyId, h.Text)">
                                        <div class="listMain">
                                            <div class="listMeta">@DisplayLabels.FormatDateTime(h.CreatedIso)</div>
                                            <div class="noteBody mt-sm">
                                                <MarkdownBlock Text="@h.Text" />
                                            </div>
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <AtlasModal Title="Note"
                    IsOpen="@(selectedHistory is not null)"
                    OnClose="this.CloseHistoryNote">
            <ChildContent>
                @if (selectedHistory is not null)
                {
                    <div class="noteMeta">
                        <span class="mutedSmall">@DisplayLabels.FormatDateTime(selectedHistory.CreatedIso)</span>
                        <span class="chip chipGhost">Risk history</span>
                    </div>

                    <div class="noteEdit">
                        <div class="noteEditTabs">
                            <button type="button"
                                    class="btn btnGhost @(this.HistoryEditTab == "Write" ? "noteEditTabActive" : null)"
                                    @onclick='() => this.HistoryEditTab = "Write"'>
                                Write
                            </button>
                            <button type="button"
                                    class="btn btnGhost @(this.HistoryEditTab == "Preview" ? "noteEditTabActive" : null)"
                                    @onclick='() => this.HistoryEditTab = "Preview"'>
                                Preview
                            </button>
                        </div>

                        @if (this.HistoryEditTab == "Write")
                        {
                            <textarea class="textarea textareaAutoGrow noteEditTextarea"
                                      value="@this.HistoryDraftText"
                                      @oninput="this.OnHistoryDraftInput"></textarea>
                        }
                        else
                        {
                            <div class="noteText noteBody">
                                <MarkdownBlock Text="@this.HistoryDraftText" />
                            </div>
                        }
                    </div>
                }
            </ChildContent>
            <Footer>
                @if (selectedHistory is not null)
                {
                    <div class="row mt-0">
                        <button class="btn btnSecondary" type="button" @onclick="this.SaveHistoryNote">Save</button>
                        <button class="btn btnGhost" type="button" @onclick="this.CloseHistoryNote">Cancel</button>
                    </div>
                }
            </Footer>
        </AtlasModal>
    }
</section>
