<section class="card subtle" aria-label="Notes tab">
    <div class="cardHeader">
        <div class="cardTitle">Notes</div>
        <div class="row" style="margin-top: 0">
            <button class="btn" type="button" @onclick="OpenNew">+ New</button>
        </div>
    </div>

    <div class="pad">
        <div class="tasksFiltersRow" aria-label="Notes filters">
            <label class="field" style="grid-column: 1 / span 2">
                <div class="fieldLabel">Search</div>
                <input class="input" placeholder="Search notes by title, tag, person, or text…" @bind="this.Query" @bind:event="oninput" />
            </label>
            <label class="field">
                <div class="fieldLabel">Tag</div>
                <select class="select" @bind="this.TagFilter">
                    <option value="All">Any tag</option>
                    @foreach (NoteTag t in NoteTags)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </label>
            <label class="field">
                <div class="fieldLabel">Sort</div>
                <select class="select" @bind="this.SortBy">
                    <option value="Newest">Newest first</option>
                    <option value="Oldest">Oldest first</option>
                </select>
            </label>
        </div>

        <div class="chipRow memberNotesQuickFilters" aria-label="Notes quick filters">
            <button type="button" class="chipBtn @(this.QuickFilter == "All" ? "chipBtnActive" : null)" @onclick='() => this.QuickFilter = "All"'>All</button>
            <button type="button" class="chipBtn @(this.QuickFilter == "ThisWeek" ? "chipBtnActive" : null)" @onclick='() => this.QuickFilter = "ThisWeek"'>This Week</button>
            <button type="button" class="chipBtn @(this.QuickFilter == "ActionItems" ? "chipBtnActive" : null)" @onclick='() => this.QuickFilter = "ActionItems"'>Action Items</button>
            <button type="button" class="chipBtn @(this.QuickFilter == "OneOnOne" ? "chipBtnActive" : null)" @onclick='() => this.QuickFilter = "OneOnOne"'>1:1</button>
            <button type="button" class="chipBtn @(this.QuickFilter == "Risks" ? "chipBtnActive" : null)" @onclick='() => this.QuickFilter = "Risks"'>Risks</button>
        </div>

        <div class="list listCard memberNotesList">
            @if (this.FilteredSorted.Count == 0)
            {
                <div class="muted pad">No notes match your filters.</div>
            }
            else
            {
                @foreach (TeamNote n in this.FilteredSorted)
                {
                    TeamNote note = n;
                    bool expanded = this.ExpandedNoteId == note.Id;
                    <div @key="note.Id" class="listRow memberNotesRow memberNotesRowBtn @(expanded ? "memberNotesRowExpanded" : null)"
                         role="button"
                         tabindex="0"
                         aria-expanded="@expanded"
                         @onclick="() => ToggleExpand(note.Id)"
                         @ondblclick="() => OpenFull(note.Id)"
                         @onkeydown="e => OnRowKey(e, note.Id)">
                        <div class="listMain">
                            <div class="memberNotesHeaderRow">
                                <div class="memberNotesHeaderLeft">
                                    <div class="listTitle memberNotesTitle">@DisplayLabels.GetDerivedTitle(note)</div>
                                    <div class="listMeta memberNotesMeta">
                                        @DisplayLabels.FormatLocalDate(note.CreatedIso)
                                        @if (!string.IsNullOrEmpty(note.AdoWorkItemId))
                                        {
                                            <text> • ADO: @note.AdoWorkItemId</text>
                                        }
                                    </div>
                                </div>
                                <div class="memberNotesRowActions">
                                    <button type="button"
                                            class="chip chipTag chipTag-@note.Tag.ToString().ToLowerInvariant() memberNotesTagPill"
                                            title="Open note"
                                            @onclick="e => OpenNoteModal(e, note.Id)"
                                            @onclick:stopPropagation="true">
                                        @note.Tag
                                    </button>
                                    <button type="button"
                                            class="btn btnGhost btnIcon"
                                            title="Open full page"
                                            @onclick="e => OpenFullClick(e, note.Id)"
                                            @onclick:stopPropagation="true">
                                        ↗
                                    </button>
                                    <button type="button"
                                            class="btn btnGhost btnIcon"
                                            title="@(expanded ? "Collapse" : "Expand")"
                                            @onclick="e => ToggleExpandClick(e, note.Id)"
                                            @onclick:stopPropagation="true">
                                        @(expanded ? "▾" : "▸")
                                    </button>
                                </div>
                            </div>
                            @if (expanded)
                            {
                                <div class="memberNotesExpandedBody">
                                    <div class="noteText noteBody memberNotesExpandedMarkdown">
                                        <MarkdownBlock Text="@note.Text" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="memberNotesCollapsedMarkdown">
                                    <MarkdownBlock Text="@note.Text" />
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<AtlasModal Title="@(SelectedNote is null ? "Note" : DisplayLabels.GetDerivedTitle(SelectedNote))"
            IsOpen="@(SelectedNote is not null)"
            OnClose="CloseNoteModal">
    <ChildContent>
        @if (SelectedNote is not null)
        {
            <div class="noteMeta">
                <span class="chip chipTag chipTag-@SelectedNote.Tag.ToString().ToLowerInvariant()">@SelectedNote.Tag</span>
                <span class="mutedSmall">@DisplayLabels.FormatDateTime(SelectedNote.CreatedIso)</span>
                @if (!string.IsNullOrEmpty(SelectedNote.AdoWorkItemId))
                {
                    <span class="chip chipGhost">ADO: @SelectedNote.AdoWorkItemId</span>
                }
                @if (!string.IsNullOrEmpty(SelectedNote.PrUrl))
                {
                    <span class="chip chipGhost">PR</span>
                }
            </div>
            @if (this.IsEditOpen)
            {
                <div class="noteEdit">
                    <div class="fieldGrid2" style="margin-bottom: 12px">
                        <label class="field">
                            <div class="fieldLabel">ADO work item id (optional)</div>
                            <input class="input" @bind="this.DraftAdo" @bind:event="oninput" placeholder="e.g., 12345" />
                        </label>
                        <label class="field">
                            <div class="fieldLabel">PR URL (optional)</div>
                            <input class="input" @bind="this.DraftPr" @bind:event="oninput" placeholder="https://…" />
                        </label>
                    </div>
                    <div class="noteEditTabs">
                        <button type="button" class="btn btnGhost @(this.EditTab == "Write" ? "noteEditTabActive" : null)" @onclick='() => this.EditTab = "Write"'>Write</button>
                        <button type="button" class="btn btnGhost @(this.EditTab == "Preview" ? "noteEditTabActive" : null)" @onclick='() => this.EditTab = "Preview"'>Preview</button>
                    </div>
                    @if (this.EditTab == "Write")
                    {
                        <textarea class="textarea textareaAutoGrow noteEditTextarea" @bind="this.DraftText" @bind:event="oninput"></textarea>
                    }
                    else
                    {
                        <div class="noteText noteBody"><MarkdownBlock Text="@this.DraftText" /></div>
                    }
                </div>
            }
            else
            {
                <div class="noteText noteBody"><MarkdownBlock Text="@SelectedNote.Text" /></div>
            }
        }
    </ChildContent>
    <Footer>
        @if (SelectedNote is not null)
        {
            <div class="row" style="margin-top: 0">
                @if (this.IsEditOpen)
                {
                    <button class="btn btnSecondary" type="button" @onclick="SaveNoteEdit">Save</button>
                    <button class="btn btnGhost" type="button" @onclick="CancelNoteEdit">Cancel</button>
                }
                else
                {
                    <button class="btn btnGhost" type="button" @onclick="BeginNoteEdit">Edit</button>
                }
                <button class="btn btnGhost" type="button" @onclick="() => OpenFull(SelectedNote.Id)">Open full page</button>
            </div>
        }
    </Footer>
</AtlasModal>

<AtlasModal Title="New note" IsOpen="this.IsNewOpen" OnClose="CloseNew">
    <ChildContent>
        <div class="fieldGrid">
            <label class="field">
                <div class="fieldLabel">Tag</div>
                <select class="select" value="@this.NewTag" @onchange="e => this.NewTag = Enum.Parse<NoteTag>((string)e.Value!)">
                    @foreach (NoteTag t in NoteTags)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </label>
            <label class="field">
                <div class="fieldLabel">Title (optional)</div>
                <input class="input" @bind="this.NewTitle" @bind:event="oninput" placeholder="e.g., 1:1 follow-ups, Standup recap…" />
            </label>
            <label class="field">
                <div class="fieldLabel">ADO work item id (optional)</div>
                <input class="input" @bind="this.NewAdo" @bind:event="oninput" placeholder="e.g., 12345" />
            </label>
            <label class="field">
                <div class="fieldLabel">PR URL (optional)</div>
                <input class="input" @bind="this.NewPr" @bind:event="oninput" placeholder="https://…" />
            </label>
            <label class="field">
                <div class="fieldLabel">Note</div>
                <textarea class="textarea" @bind="this.NewText" @bind:event="oninput" placeholder="Write your note…"></textarea>
            </label>
        </div>
    </ChildContent>
    <Footer>
        <div class="row" style="margin-top: 0">
            <button class="btn btnSecondary" type="button" @onclick="CreateNote">Create</button>
            <button class="btn btnGhost" type="button" @onclick="CloseNew">Cancel</button>
        </div>
    </Footer>
</AtlasModal>
