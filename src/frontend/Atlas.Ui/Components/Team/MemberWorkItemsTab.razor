<section class="card subtle" aria-label="Work items tab">
    <div class="cardHeader">
        <div class="cardTitle">Work Items</div>
    </div>
    <div class="pad">
        <div class="tasksFiltersRow" aria-label="Work items filters">
            <label class="field" style="grid-column: 1 / span 3">
                <div class="fieldLabel">Search</div>
                <input class="input" placeholder="Search by id, title, or status…" @bind="this.Query" @bind:event="oninput" />
            </label>
            <label class="field">
                <div class="fieldLabel">Status</div>
                <select class="select" @bind="this.StatusFilter">
                    @foreach (string s in StatusOptions)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </label>
        </div>

        <div class="chipRow memberWorkItemsQuickFilters" aria-label="Work items quick filters">
            <button type="button" class="chipBtn @(this.QuickFilter == "All" ? "chipBtnActive" : null)" @onclick='() => this.QuickFilter = "All"'>All</button>
            <button type="button" class="chipBtn @(this.QuickFilter == "Current" ? "chipBtnActive" : null)" title="In progress, blocked, or in review" @onclick='() => this.QuickFilter = "Current"'>Current</button>
            <button type="button" class="chipBtn @(this.QuickFilter == "InReview" ? "chipBtnActive" : null)" @onclick='() => this.QuickFilter = "InReview"'>In Review</button>
            <button type="button" class="chipBtn @(this.QuickFilter == "Blocked" ? "chipBtnActive" : null)" @onclick='() => this.QuickFilter = "Blocked"'>Blocked</button>
        </div>

        <div class="focusTicketsList" role="list">
            @if (Filtered.Count == 0)
            {
                <div class="muted pad">No work items match your search.</div>
            }
            else
            {
                @foreach (AzureItem a in Filtered)
                {
                    AzureItem item = a;
                    <button @key="item.Id"
                            type="button"
                            class="focusTicketRow focusTicketRowBtn @Tones.TicketAttentionTone(item.Status)"
                            @onclick="() => OpenItem(item.Id)">
                        <div class="listMain">
                            <div class="listTitle">@item.Id — @item.Title</div>
                            <div class="listMeta">
                                @item.Status
                                @if (!string.IsNullOrEmpty(item.TimeTaken))
                                {
                                    <text> • @item.TimeTaken</text>
                                }
                            </div>
                        </div>
                    </button>
                }
            }
        </div>
    </div>
</section>
