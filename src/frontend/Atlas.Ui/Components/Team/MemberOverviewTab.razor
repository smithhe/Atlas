<div class="memberOverviewGrid" aria-label="Team member overview">
    <section class="card subtle" aria-label="Profile">
        <div class="cardHeader">
            <div class="cardTitle">Profile</div>
            <button class="btn btnGhost" type="button" @onclick="OpenProfileModal">Edit</button>
        </div>
        <div class="pad">
            <div class="memberProfileSummary">
                <div class="memberProfileName">@Member.Name</div>
                <div class="memberProfileRole">@(Member.Role ?? "—")</div>
            </div>
            <div class="memberProfileMetaGrid" aria-label="Profile details">
                <div class="memberProfileMetaItem">
                    <div class="memberProfileMetaLabel">Time zone</div>
                    <div class="memberProfileMetaValue">@(Member.Profile.TimeZone ?? "—")</div>
                </div>
                <div class="memberProfileMetaItem">
                    <div class="memberProfileMetaLabel">Typical hours</div>
                    <div class="memberProfileMetaValue">@(Member.Profile.TypicalHours ?? "—")</div>
                </div>
            </div>
        </div>
    </section>

    <section class="card subtle memberOverviewFocus" aria-label="Focus Right Now">
        <div class="cardHeader">
            <div class="cardTitle">Focus Right Now</div>
            <button class="btn btnGhost" type="button" @onclick="OpenFocusModal">Edit</button>
        </div>
        <div class="pad memberOverviewFocusBody">
            <div class="memberOverviewFocusSummary @(string.IsNullOrWhiteSpace(Member.CurrentFocus) ? "muted" : null)">
                @(string.IsNullOrWhiteSpace(Member.CurrentFocus) ? "No current focus set." : Member.CurrentFocus)
            </div>
            <div class="memberOverviewFocusDivider" aria-hidden="true"></div>
            <div class="memberOverviewFocusLabel">
                Current work items@(CurrentTickets.Count > 3 ? $" ({CurrentTickets.Count})" : "")
            </div>
            @if (TopCurrentTickets.Count == 0)
            {
                <div class="mutedSmall">No current work items.</div>
            }
            else
            {
                <ul class="memberOverviewBullets">
                    @foreach (AzureItem t in TopCurrentTickets)
                    {
                        string workItemId = t.Id;
                        <li>
                            <button type="button"
                                    class="linkBtn @Tones.TicketAttentionTone(t.Status)"
                                    title="Open work item"
                                    @onclick="() => OnGoToWorkItem.InvokeAsync(workItemId)">
                                @t.Id — @t.Title
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    <section class="card subtle" aria-label="At-a-glance signals">
        <div class="cardHeader">
            <div class="cardTitle">At-a-glance Signals</div>
            <button class="btn btnGhost" type="button" @onclick="OpenSignalsModal">Edit</button>
        </div>
        <div class="pad">
            <div class="signalPillsRow" aria-label="Signals">
                <button type="button" class="pill pillBtn @Tones.SignalTone(Member.Signals.Load.ToString())" @onclick="CycleLoad">
                    Load: @Member.Signals.Load
                </button>
                <button type="button" class="pill pillBtn @Tones.SignalTone(Member.Signals.Delivery.ToString())" @onclick="CycleDelivery">
                    Delivery: @DisplayLabels.DeliveryLabel(Member.Signals.Delivery)
                </button>
                <button type="button" class="pill pillBtn @Tones.SignalTone(Member.Signals.SupportNeeded.ToString())" @onclick="CycleSupport">
                    Support needed: @Member.Signals.SupportNeeded
                </button>
            </div>
            <div class="mutedSmall" style="margin-top: 12px">Manually maintained, non-evaluative signals</div>
        </div>
    </section>

    <section class="card subtle span2" aria-label="Pinned Notes preview">
        <div class="cardHeader">
            <div class="cardTitle">Pinned Notes (Preview)</div>
            <button class="btn btnGhost" type="button" @onclick="OnGoToNotes">View all notes</button>
        </div>
        <div class="pad pinnedNotesPreview">
            @if (PinnedNotes.Count == 0)
            {
                <div class="muted">No pinned notes.</div>
            }
            else
            {
                <div class="notesList" style="margin-top: 0">
                    @foreach (TeamNote n in PinnedNotes)
                    {
                        <button type="button" class="noteRow noteRowBtn" title="Open Notes tab" @onclick="OnGoToNotes">
                            <div class="noteMeta">
                                <span class="chip chipTag chipTag-@n.Tag.ToString().ToLowerInvariant()">@n.Tag</span>
                                <span class="mutedSmall">@DisplayLabels.FormatLocalDate(n.CreatedIso)</span>
                            </div>
                            <div class="listTitle listTitleWrap">@DisplayLabels.GetDerivedTitle(n)</div>
                            <div class="listMeta listMetaWrap listNotesPreview">@GetPreview(n)</div>
                        </button>
                    }
                </div>
            }
        </div>
    </section>

    <section class="card subtle span2" aria-label="Recent Activity Snapshot">
        <div class="cardHeader">
            <div class="cardTitle">Recent Activity Snapshot (30–60 days)</div>
        </div>
        <div class="pad">
            <div class="mutedSmall" style="margin-bottom: 10px">High-signal things worth remembering:</div>
            @if (Member.ActivitySnapshot.Bullets.Count == 0)
            {
                <div class="muted">No activity snapshot yet.</div>
            }
            else
            {
                <ul class="memberOverviewBullets">
                    @foreach (string b in Member.ActivitySnapshot.Bullets)
                    {
                        <li>@b</li>
                    }
                </ul>
            }
            <div class="memberOverviewFooterRow">
                @if (!string.IsNullOrEmpty(Member.ActivitySnapshot.LastUpdatedIso))
                {
                    <div class="mutedSmall">Last updated: @DisplayLabels.FormatDateTime(Member.ActivitySnapshot.LastUpdatedIso)</div>
                }
                else
                {
                    <div></div>
                }
                <div></div>
            </div>
        </div>
    </section>
</div>

<AtlasModal Title="Edit profile" IsOpen="_profileOpen" OnClose="CloseProfileModal">
    <ChildContent>
        <div class="fieldGrid">
            <label class="field">
                <div class="fieldLabel">Name</div>
                <input class="input" @bind="_profileName" @bind:event="oninput" placeholder="Full name" />
            </label>
            <label class="field">
                <div class="fieldLabel">Role / Level</div>
                <input class="input" @bind="_profileRole" @bind:event="oninput" placeholder="e.g., Senior Engineer" />
            </label>
            <label class="field">
                <div class="fieldLabel">Time zone</div>
                <select class="select" @bind="_profileTz">
                    <option value="">(Select)</option>
                    @foreach ((string Value, string Label) tz in TimeZones)
                    {
                        <option value="@tz.Value">@tz.Label</option>
                    }
                </select>
            </label>
            <label class="field">
                <div class="fieldLabel">Typical hours</div>
                <input class="input" @bind="_profileHours" @bind:event="oninput" placeholder="e.g., 9–5" />
            </label>
        </div>
    </ChildContent>
    <Footer>
        <div class="row" style="margin-top: 0">
            <button class="btn btnSecondary" type="button" @onclick="SaveProfile">Save</button>
            <button class="btn btnGhost" type="button" @onclick="CloseProfileModal">Cancel</button>
        </div>
    </Footer>
</AtlasModal>

<AtlasModal Title="Edit signals" IsOpen="_signalsOpen" OnClose="() => _signalsOpen = false">
    <ChildContent>
        <div class="fieldGrid">
            <label class="field">
                <div class="fieldLabel">Load</div>
                <select class="select" value="@_draftLoad" @onchange="e => _draftLoad = Enum.Parse<LoadSignal>((string)e.Value!)">
                    @foreach (LoadSignal x in LoadOptions)
                    {
                        <option value="@x">@x</option>
                    }
                </select>
            </label>
            <label class="field">
                <div class="fieldLabel">Delivery</div>
                <select class="select" value="@_draftDelivery" @onchange="e => _draftDelivery = Enum.Parse<DeliverySignal>((string)e.Value!)">
                    @foreach (DeliverySignal x in DeliveryOptions)
                    {
                        <option value="@x">@(x == DeliverySignal.OnTrack ? "On Track" : x == DeliverySignal.AtRisk ? "At Risk" : x.ToString())</option>
                    }
                </select>
            </label>
            <label class="field">
                <div class="fieldLabel">Support needed</div>
                <select class="select" value="@_draftSupport" @onchange="e => _draftSupport = Enum.Parse<SupportNeededSignal>((string)e.Value!)">
                    @foreach (SupportNeededSignal x in SupportOptions)
                    {
                        <option value="@x">@x</option>
                    }
                </select>
            </label>
        </div>
    </ChildContent>
    <Footer>
        <div class="row" style="margin-top: 0">
            <button class="btn btnSecondary" type="button" @onclick="SaveSignals">Save</button>
            <button class="btn btnGhost" type="button" @onclick="() => _signalsOpen = false">Cancel</button>
        </div>
    </Footer>
</AtlasModal>

<AtlasModal Title="Edit focus right now" IsOpen="_focusOpen" OnClose="CloseFocusModal">
    <ChildContent>
        <div class="fieldGrid">
            <label class="field">
                <div class="fieldLabel">Current focus</div>
                <textarea class="textarea" @bind="_focusDraft" @bind:event="oninput" placeholder="What is this person focused on right now?"></textarea>
            </label>
        </div>
    </ChildContent>
    <Footer>
        <div class="row" style="margin-top: 0">
            <button class="btn btnSecondary" type="button" @onclick="SaveFocus">Save</button>
            <button class="btn btnGhost" type="button" @onclick="CloseFocusModal">Cancel</button>
        </div>
    </Footer>
</AtlasModal>
