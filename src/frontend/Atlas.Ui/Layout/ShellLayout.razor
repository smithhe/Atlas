@inherits LayoutComponentBase
@implements IAsyncDisposable
<div class="appShell">
    <header class="topBar">
        <div class="topBarLeft">
            <div class="appTitleRow">
                <div class="appTitle">Atlas</div>
                @if (this._cache.IsHydrating)
                {
                    <span class="spinner spinner-sm spinnerInline topBarSpinner" role="status" aria-label="Loading data"></span>
                }
            </div>
        </div>
        <div class="topBarCenter">
            <GlobalSearch />
        </div>
        <div class="topBarRight">
            <button class="btn btnSecondary" type="button" @onclick="OpenQuickAdd">+ Quick Add</button>
            <button class="btn" type="button" @onclick="ToggleAi">AI ▸</button>
        </div>
    </header>

    <div class="@BodyGridClass" style="@AiWidthStyle">
        <nav class="leftNav" role="navigation" aria-label="Primary navigation">
            @foreach (NavItem item in NavItems)
            {
                <NavLink href="@item.Href" class="navBtn" ActiveClass="navBtnActive">@item.Label</NavLink>
            }
        </nav>

        <main class="mainContent" aria-label="Main content">
            <div class="srOnly" aria-hidden="true">@ContextTitle</div>
            <div class="loadingOverlayWrap @(this._cache.IsHydrating ? "loadingOverlayWrapActive" : null)">
                <div class="loadingOverlayBody" aria-hidden="@(this._cache.IsHydrating ? "true" : null)">
                    <ErrorBoundary @ref="this.ErrorBoundaryRef">
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent>
                            <div class="card pad">
                                <div class="textBad">Something went wrong loading this view.</div>
                                <button class="btn btnSecondary mt-sm" type="button" @onclick="RecoverFromError">Retry</button>
                            </div>
                        </ErrorContent>
                    </ErrorBoundary>
                </div>
                @if (this._cache.IsHydrating)
                {
                    <div class="loadingOverlay" role="presentation">
                        <span class="spinner spinner-md" role="status" aria-label="Loading app data"></span>
                    </div>
                }
            </div>
        </main>

        @if (this._ai.IsOpen)
        {
            <div @ref="this.ResizerRef"
                 class="aiResizer"
                 role="separator"
                 aria-orientation="vertical"
                 aria-label="Resize AI panel"
                 tabindex="0"
                 @ondblclick="ResetAiWidth"
                 @onpointerdown="OnResizePointerDown"
                 @onkeydown="OnResizeKeyDown"></div>
            <AiPanel />
        }
    </div>

    <QuickAddModal IsOpen="this.QuickAddOpen" OnClose="CloseQuickAdd" />
</div>
