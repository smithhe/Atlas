@page "/settings/azure-import"
<PageTitle>Azure Import — Atlas</PageTitle>

<div class="page">
    <div class="pageBreadcrumbs">
        <a class="crumbLink" href="/settings">Settings</a>
        <span class="crumbSep">/</span>
        <span class="crumbCurrent">Azure Import</span>
    </div>
    <h2 class="pageTitle">Azure DevOps Import</h2>

    @if (!string.IsNullOrEmpty(this.Error))
    {
        <div class="card pad" style="margin-bottom: 12px">
            <div class="textBad">Error: @this.Error</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(this.ProductOwnerWarning))
    {
        <div class="card pad" style="margin-bottom: 12px">
            <div class="textWarn">@this.ProductOwnerWarning</div>
        </div>
    }

    <div class="card" style="margin-bottom: 16px">
        <div class="cardHeader">
            <div class="cardTitle">Select Azure team members</div>
            <div class="mutedSmall">@this.Users.Count available</div>
        </div>
        <div class="pad">
            @if (this.Loading)
            {
                <div class="mutedSmall">Loading Azure import data…</div>
            }
            else if (string.IsNullOrWhiteSpace(this.Connection?.Organization))
            {
                <div class="mutedSmall">Set your Azure organization in Settings before importing users.</div>
            }
            else if (this.Users.Count > 0)
            {
                <div class="rowTiny" style="margin-top: 10px; align-items: center">
                    <button type="button" class="btn btnGhost" disabled="@(this.Users.Count == 0)" @onclick="this.SelectAllUsers">Select all</button>
                    <button type="button" class="btn btnGhost" disabled="@(this.SelectedUsers.Count == 0)" @onclick="this.ClearSelectedUsers">Clear</button>
                    <span class="mutedSmall" style="margin-left: auto">@this.SelectedUsers.Count selected</span>
                </div>
                <div class="list listCard" style="margin-top: 10px; max-height: 320px; overflow: auto">
                    @foreach (AzureUser u in this.Users)
                    {
                        string unique = u.UniqueName ?? "";
                        bool selected = this.SelectedUsers.Contains(unique);
                        <label class="listRow listRowBtn @(selected ? "listRowActive" : null)" style="cursor: pointer">
                            <input type="checkbox" checked="@selected" @onchange="e => ToggleUser(unique, e)" />
                            <div class="listMain">
                                <div class="listTitle">@(string.IsNullOrEmpty(u.DisplayName) ? unique : u.DisplayName)</div>
                                @if (!string.IsNullOrEmpty(u.DisplayName))
                                {
                                    <div class="listMeta">@unique</div>
                                }
                            </div>
                        </label>
                    }
                </div>
            }
            else
            {
                <div class="muted">No new users to import.</div>
            }
        </div>
        <div class="cardFooter">
            <div class="rowTiny" style="align-items: center">
                <button class="btn btnWide"
                        type="button"
                        disabled="@(this.SelectedUsers.Count == 0 || this.Loading || this.ImportingProductOwners || this.ImportingUsers)"
                        @onclick="this.OnImportUsers">
                    @(this.ImportingUsers ? "Importing…" : "Import as team members")
                </button>
                <button class="btn btnWide"
                        type="button"
                        disabled="@(this.SelectedUsers.Count == 0 || this.Loading || this.ImportingUsers || this.ImportingProductOwners)"
                        @onclick="this.OnImportProductOwners">
                    @(this.ImportingProductOwners ? "Importing…" : "Import as product owners")
                </button>
                <div class="mutedSmall">Select users once, then import to either target list.</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="cardHeader">
            <div class="cardTitle">Work items awaiting import</div>
            <div class="mutedSmall">@this.ImportWorkItems.Count items</div>
        </div>
        @if (this.Loading)
        {
            <div class="pad muted">Loading Azure import data…</div>
        }
        else if (this.ImportWorkItems.Count == 0)
        {
            <div class="pad muted">No work items awaiting import.</div>
        }
        else
        {
            <div class="pad">
                <div class="fieldGrid2" style="margin-bottom: 12px">
                    <label class="field">
                        <div class="fieldLabel">Target project</div>
                        <select class="input" value="@this.ProjectId" @onchange="this.OnProjectChange">
                            <option value="">Select project</option>
                            @foreach (Project p in this._cache.Projects)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </label>
                    <label class="field">
                        <div class="fieldLabel">Assign to</div>
                        <select class="input" value="@this.TeamMemberId" @onchange="this.OnTeamMemberChange">
                            <option value="">Auto-assign from mapping</option>
                            @foreach (TeamMember m in this._cache.Team)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        </select>
                    </label>
                </div>

                <div class="rowTiny" style="align-items: center; margin-bottom: 12px">
                    <button class="btn btnWide"
                            type="button"
                            disabled="@(string.IsNullOrEmpty(this.ProjectId) || this.SelectedWorkItems.Count == 0 || this.LinkingWorkItems)"
                            @onclick="this.OnLinkWorkItems">
                        @(this.LinkingWorkItems ? "Linking…" : "Link selected")
                    </button>
                    <button type="button"
                            class="btn btnGhost"
                            disabled="@(this.SelectedWorkItems.Count == 0 || this.LinkingWorkItems)"
                            @onclick="this.OnIgnoreSelectedWorkItems">
                        Ignore selected
                    </button>
                    <div class="mutedSmall">
                        @(string.IsNullOrEmpty(this.SelectedProjectName)
                            ? "Select a project to link work items."
                            : $"Linking to {this.SelectedProjectName}.")
                    </div>
                    <span class="mutedSmall" style="margin-left: auto">@this.SelectedWorkItems.Count selected</span>
                </div>

                <div class="tableGrid" style="grid-template-columns: 40px 100px 1fr 120px 160px 140px">
                    <div class="tableCell tableHeader">✓</div>
                    <div class="tableCell tableHeader">ID</div>
                    <div class="tableCell tableHeader">Title</div>
                    <div class="tableCell tableHeader">State</div>
                    <div class="tableCell tableHeader">Assigned</div>
                    <div class="tableCell tableHeader">Type</div>

                    @foreach (AzureImportWorkItem item in this.ImportWorkItems)
                    {
                        if (item.Id == Guid.Empty) continue;
                        Guid itemId = item.Id;
                        bool isSelected = this.SelectedWorkItems.Contains(itemId);
                        string? assigned = item.SuggestedTeamMemberId is { } mid
                            ? this._cache.Team.FirstOrDefault(m => m.Id == mid)?.Name
                            : null;
                        <div @key="itemId" class="tableRow">
                            <div class="tableCell">
                                <input type="checkbox" checked="@isSelected" @onchange="e => ToggleWorkItem(itemId, e)" />
                            </div>
                            <div class="tableCell">@item.WorkItemId</div>
                            <div class="tableCell truncate">
                                @if (!string.IsNullOrEmpty(item.Url))
                                {
                                    <a href="@item.Url" target="_blank" rel="noreferrer">@(item.Title ?? "(untitled)")</a>
                                }
                                else
                                {
                                    @(item.Title ?? "(untitled)")
                                }
                            </div>
                            <div class="tableCell">@item.State</div>
                            <div class="tableCell">
                                @if (!string.IsNullOrEmpty(assigned))
                                {
                                    @assigned
                                }
                                else
                                {
                                    <span class="chip chipGhost">Unmatched</span>
                                }
                            </div>
                            <div class="tableCell">@item.WorkItemType</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
