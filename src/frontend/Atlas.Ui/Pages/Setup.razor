@page "/setup"
@layout EmptyLayout
@implements IAsyncDisposable
<PageTitle>Azure Setup — Atlas</PageTitle>

<div class="entryShell">
    <header class="entryHeader" @ref="this.HeaderRef">
        <div class="entryHeaderInner">
            <div class="pageHeader">
                <div class="pageHeaderLeft">
                    <h2 class="pageHeaderTitle">Azure Setup</h2>
                    <div class="pageHeaderSubtitle">
                        Connect your Azure DevOps organization, choose a project and team, then import members.
                    </div>
                </div>
                <div class="pageHeaderRight" style="display: flex; gap: 8px; align-items: center;">
                    <button class="btn btnSecondary" type="button" @onclick="Skip">Skip for now</button>
                    <span class="pill toneInfo">
                        <span class="btnContent">
                            @StepLabel
                            @if (this.Step == SetupStep.Saving)
                            {
                                <span class="spinner spinner-sm spinnerInline" role="status" aria-label="Saving Azure connection"></span>
                            }
                        </span>
                    </span>
                </div>
            </div>
        </div>
    </header>

    <div class="page entryPage">
        <div class="card pad" style="margin-bottom: 16px">
            <div class="fieldGrid2">
                <label class="field span2">
                    <div class="fieldLabel setupOrgLabel">Organization (required)</div>
                    <input class="input"
                           value="@this.Organization"
                           @oninput="OnOrganizationInput"
                           placeholder="e.g. contoso"
                           autocapitalize="none"
                           autocorrect="off"
                           spellcheck="false" />
                    <div class="mutedSmall">This is the Azure DevOps organization name in your URL.</div>
                </label>
            </div>

            <div class="rowTiny" style="margin-top: 12px; align-items: center">
                <button class="btn btnWide"
                        type="button"
                        disabled="@(this.Loading || string.IsNullOrWhiteSpace(this.Organization))"
                        @onclick="OnLoadProjects">
                    <span class="btnContent">
                        @if (this.Loading && this.Step == SetupStep.Project)
                        {
                            <span class="spinner spinner-sm spinnerInline" role="status" aria-label="Loading projects"></span>
                        }
                        Load projects
                    </span>
                </button>
                <div class="mutedSmall">
                    @if (string.IsNullOrWhiteSpace(this.Organization))
                    {
                        <text>Enter an organization to continue.</text>
                    }
                    else
                    {
                        <text>Next: choose a project and team.</text>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(this.Error))
        {
            <div class="card pad" style="margin-bottom: 12px">Error: @this.Error</div>
        }

        @if (this.Projects.Count > 0)
        {
            <div class="card pad scrollCard" @ref="this.ProjectsCardRef" style="margin-bottom: 16px">
                <div class="loadingOverlayWrap @(this.Loading && this.Step == SetupStep.Project ? "loadingOverlayWrapActive" : null)">
                    <div class="loadingOverlayBody">
                        <h3>Select project</h3>
                        <label class="field" style="margin-top: 8px">
                            <div class="fieldLabel">Search</div>
                            <input class="input"
                                   value="@this.ProjectQuery"
                                   @oninput="OnProjectQueryInput"
                                   placeholder="Filter projects…" />
                        </label>
                        <div class="mutedSmall" style="margin-top: 8px">
                            @(string.IsNullOrEmpty(this.SelectedProjectId) ? "Choose one project." : "Project selected.") • @FilteredProjects.Count shown
                        </div>
                        <div class="list listCard" style="margin-top: 10px; max-height: 260px; overflow: auto">
                            @foreach (AzureProject p in FilteredProjects)
                            {
                                string projectId = p.Id;
                                bool selected = projectId == this.SelectedProjectId;
                                <button @key="projectId"
                                        type="button"
                                        class="listRow listRowBtn @(selected ? "listRowActive" : null)"
                                        disabled="@this.Loading"
                                        @onclick="() => OnSelectProject(projectId)">
                                    <div class="listMain">
                                        <div class="listTitle">@p.Name</div>
                                    </div>
                                    @if (selected)
                                    {
                                        <span class="pill toneInfo">this.Selected</span>
                                    }
                                </button>
                            }
                            @if (FilteredProjects.Count == 0)
                            {
                                <div class="muted pad">No projects match your search.</div>
                            }
                        </div>
                    </div>
                    @if (this.Loading && this.Step == SetupStep.Project)
                    {
                        <div class="loadingOverlay" role="presentation">
                            <span class="spinner spinner-md" role="status" aria-label="Loading projects"></span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (this.Teams.Count > 0)
        {
            <div class="card pad scrollCard" @ref="this.TeamsCardRef" style="margin-bottom: 16px">
                <div class="loadingOverlayWrap @(this.Loading && this.Step == SetupStep.Team ? "loadingOverlayWrapActive" : null)">
                    <div class="loadingOverlayBody">
                        <h3>Select team</h3>
                        <label class="field" style="margin-top: 8px">
                            <div class="fieldLabel">Search</div>
                            <input class="input"
                                   value="@this.TeamQuery"
                                   @oninput="OnTeamQueryInput"
                                   placeholder="Filter teams…" />
                        </label>
                        <div class="mutedSmall" style="margin-top: 8px">
                            @(string.IsNullOrEmpty(this.SelectedTeamId) ? "Choose one team." : "Team selected.") • @FilteredTeams.Count shown
                        </div>
                        <div class="list listCard" style="margin-top: 10px; max-height: 320px; overflow: auto">
                            @foreach (AzureTeam t in FilteredTeams)
                            {
                                string teamId = t.Id ?? "";
                                string teamName = t.Name ?? "";
                                bool selected = teamId == this.SelectedTeamId;
                                <button @key="teamId"
                                        type="button"
                                        class="listRow listRowBtn @(selected ? "listRowActive" : null)"
                                        disabled="@this.Loading"
                                        @onclick="() => OnSelectTeam(teamId, teamName)">
                                    <div class="listMain">
                                        <div class="listTitle">@t.Name</div>
                                    </div>
                                    @if (selected)
                                    {
                                        <span class="pill toneInfo">this.Selected</span>
                                    }
                                </button>
                            }
                            @if (FilteredTeams.Count == 0)
                            {
                                <div class="muted pad">No teams match your search.</div>
                            }
                        </div>
                    </div>
                    @if (this.Loading && this.Step == SetupStep.Team)
                    {
                        <div class="loadingOverlay" role="presentation">
                            <span class="spinner spinner-md" role="status" aria-label="Loading teams"></span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(this.SelectedTeamId))
        {
            <div class="card pad scrollCard" @ref="this.AreaPathCardRef" style="margin-bottom: 16px">
                <div class="loadingOverlayWrap @(this.AreaPathLoading ? "loadingOverlayWrapActive" : null)">
                    <div class="loadingOverlayBody">
                        <h3>Default area path</h3>
                        <label class="field" style="margin-top: 8px">
                            <div class="fieldLabel">Resolved from team settings</div>
                            <input class="input inputReadonly"
                                   value="@this.AreaPath"
                                   readonly
                                   placeholder="(not available)"
                                   title="Read-only (resolved from team settings)" />
                            <div class="mutedSmall">
                                This is the team’s default Area Path and will be saved with the connection.
                                @if (!string.IsNullOrEmpty(this.AreaPathError))
                                {
                                    <text> (Could not load default: @this.AreaPathError)</text>
                                }
                                You can override it later in Settings.
                            </div>
                        </label>
                    </div>
                    @if (this.AreaPathLoading)
                    {
                        <div class="loadingOverlay" role="presentation">
                            <span class="spinner spinner-sm" role="status" aria-label="Loading area path"></span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (this.Users.Count > 0)
        {
            <div class="card pad scrollCard" @ref="this.MembersCardRef">
                <div class="loadingOverlayWrap @(this.Step == SetupStep.Saving ? "loadingOverlayWrapActive" : null)">
                    <div class="loadingOverlayBody">
                        <h3>Select members to import</h3>
                        <label class="field" style="margin-top: 8px">
                            <div class="fieldLabel">Search</div>
                            <input class="input"
                                   value="@this.MemberQuery"
                                   @oninput="OnMemberQueryInput"
                                   placeholder="Filter members…" />
                        </label>
                        <div class="rowTiny" style="margin-top: 10px">
                            <button type="button"
                                    class="btn btnGhost"
                                    disabled="@(FilteredUsers.Count == 0)"
                                    @onclick="SelectAllShown">
                                Select all shown
                            </button>
                            <button type="button"
                                    class="btn btnGhost"
                                    disabled="@(this.SelectedUsers.Count == 0)"
                                    @onclick="ClearSelectedUsers">
                                Clear
                            </button>
                            <span class="mutedSmall" style="margin-left: auto">
                                @this.SelectedUsers.Count selected • @FilteredUsers.Count shown
                            </span>
                        </div>
                        <div class="list listCard" style="margin-top: 10px; max-height: 360px; overflow: auto">
                            @foreach (AzureUser u in FilteredUsers)
                            {
                                string unique = u.UniqueName ?? "";
                                bool selected = this.SelectedUsers.Contains(unique);
                                <label class="listRow listRowBtn @(selected ? "listRowActive" : null)" style="cursor: pointer">
                                    <input type="checkbox"
                                           checked="@selected"
                                           @onchange="e => ToggleUser(unique, e)" />
                                    <div class="listMain">
                                        <div class="listTitle">@(string.IsNullOrEmpty(u.DisplayName) ? unique : u.DisplayName)</div>
                                        @if (!string.IsNullOrEmpty(u.DisplayName))
                                        {
                                            <div class="listMeta">@unique</div>
                                        }
                                    </div>
                                </label>
                            }
                            @if (FilteredUsers.Count == 0)
                            {
                                <div class="muted pad">No members match your search.</div>
                            }
                        </div>

                        <div class="row" style="margin-top: 12px">
                            <button class="btn"
                                    type="button"
                                    disabled="@this.Loading"
                                    @onclick="OnSave">
                                <span class="btnContent">
                                    @if (this.Step == SetupStep.Saving)
                                    {
                                        <span class="spinner spinner-sm spinnerInline" role="status" aria-label="Saving connection"></span>
                                    }
                                    Save connection
                                </span>
                            </button>
                        </div>
                    </div>
                    @if (this.Step == SetupStep.Saving)
                    {
                        <div class="loadingOverlay" role="presentation">
                            <span class="spinner spinner-md" role="status" aria-label="Saving connection"></span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
