@page "/team/{MemberId}/notes/{NoteId}"
<PageTitle>Note — Atlas</PageTitle>

<div class="page pageFill">
    <nav class="pageBreadcrumbs" aria-label="Breadcrumbs">
        <a class="crumbLink" href="/team">Team</a>
        <span class="crumbSep" aria-hidden="true">/</span>
        <a class="crumbLink" href="@($"/team/{MemberId}")">@(Member?.Name ?? MemberId)</a>
        <span class="crumbSep" aria-hidden="true">/</span>
        <a class="crumbLink" href="@($"/team/{MemberId}/notes")">Notes</a>
        <span class="crumbSep" aria-hidden="true">/</span>
        <span class="crumbCurrent">Note</span>
    </nav>

    <div class="detailHeader">
        <div>
            <div class="detailTitle">Note</div>
            <div class="mutedSmall">@(Member?.Name ?? "")</div>
        </div>
        <div class="row" style="margin-top: 0">
            <button class="btn btnGhost" type="button" @onclick="BackToNotes">Back to notes</button>
            <button class="btn btnGhost" type="button" @onclick="BackToMember">Back to member</button>
        </div>
    </div>

    @if (Member is null)
    {
        <div class="card pad"><div class="muted">@(Cache.TeamReady ? "Select a team member." : "Loading…")</div></div>
    }
    else if (Note is null)
    {
        <div class="card pad"><div class="muted">Note not found.</div></div>
    }
    else
    {
        <div class="card pad noteDetailCard">
            <div class="noteMeta">
                <span class="noteDetailLastUpdated">
                    <span class="noteDetailLastUpdatedLabel">Last updated</span>
                    <span class="noteDetailLastUpdatedValue">@DisplayLabels.FormatReadableDateTime(Note.LastModifiedIso ?? Note.CreatedIso)</span>
                </span>
                @if (!string.IsNullOrEmpty(Note.AdoWorkItemId))
                {
                    <span class="chip chipGhost">ADO: @Note.AdoWorkItemId</span>
                }
                @if (!string.IsNullOrEmpty(Note.PrUrl))
                {
                    <span class="chip chipGhost">PR</span>
                }
                <div class="noteActions">
                    @if (_editing)
                    {
                        <button class="btn btnSecondary" type="button" @onclick="SaveEdit">Save</button>
                        <button class="btn btnGhost" type="button" @onclick="CancelEdit">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btnGhost" type="button" @onclick="BeginEdit">Edit</button>
                    }
                </div>
            </div>

            <div class="fieldGrid2 noteDetailFields" aria-label="Note fields">
                <label class="field">
                    <div class="fieldLabel">Title</div>
                    @if (_editing)
                    {
                        <input class="input" @bind="_draftTitle" @bind:event="oninput" placeholder="@DisplayLabels.GetDerivedTitle(Note)" />
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@DisplayLabels.GetDerivedTitle(Note)</div>
                    }
                </label>
                <label class="field">
                    <div class="fieldLabel">Type</div>
                    @if (_editing)
                    {
                        <select class="select" value="@_draftTag" @onchange="e => _draftTag = Enum.Parse<NoteTag>((string)e.Value!)">
                            @foreach (NoteTag t in NoteTags)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">
                            <span class="chip chipTag chipTag-@Note.Tag.ToString().ToLowerInvariant()">@Note.Tag</span>
                        </div>
                    }
                </label>
                <label class="field">
                    <div class="fieldLabel">ADO work item id</div>
                    @if (_editing)
                    {
                        <input class="input" @bind="_draftAdo" @bind:event="oninput" placeholder="e.g., 12345" />
                    }
                    else
                    {
                        <div class="noteDetailReadonly">@(Note.AdoWorkItemId ?? "—")</div>
                    }
                </label>
                <label class="field">
                    <div class="fieldLabel">PR URL</div>
                    @if (_editing)
                    {
                        <input class="input" @bind="_draftPr" @bind:event="oninput" placeholder="https://…" />
                    }
                    else if (!string.IsNullOrEmpty(Note.PrUrl))
                    {
                        <div class="noteDetailReadonly">
                            <a href="@Note.PrUrl" target="_blank" rel="noreferrer">@Note.PrUrl</a>
                        </div>
                    }
                    else
                    {
                        <div class="noteDetailReadonly">—</div>
                    }
                </label>
            </div>

            @if (_editing)
            {
                <textarea class="textarea noteDetailTextarea" @bind="_draftText" @bind:event="oninput"></textarea>
            }
            else
            {
                <div class="noteText noteBody noteDetailBody">
                    <MarkdownBlock Text="@Note.Text" />
                </div>
            }
        </div>
    }
</div>
