@page "/team/{MemberId}/growth/goals/{GoalId}"
<PageTitle>Growth Goal — Atlas</PageTitle>

@if (!Cache.TeamReady)
{
    <div class="page">
        <h2 class="pageTitle">Growth Goal</h2>
        <div class="card pad muted">Loading…</div>
    </div>
}
else if (Member is null)
{
    <div class="page">
        <h2 class="pageTitle">Growth Goal</h2>
        <div class="card pad">
            <div class="muted">@(string.IsNullOrEmpty(MemberId) ? "Missing route params." : "Team member not found.")</div>
            <div class="row">
                <button class="btn btnSecondary" type="button" @onclick="BackToGrowth">Back to Growth</button>
            </div>
        </div>
    </div>
}
else if (_routeInitializing || _loadStatus == GrowthLoadStatus.Loading || (_loadStatus == GrowthLoadStatus.Idle && Growth is null))
{
    <div class="page">
        <h2 class="pageTitle">Growth Goal</h2>
        <div class="card pad muted">Loading growth data…</div>
    </div>
}
else if (_loadStatus == GrowthLoadStatus.Failed)
{
    <div class="page">
        <h2 class="pageTitle">Growth Goal</h2>
        <div class="card pad">
            <div class="muted">@(_loadError ?? "Unable to load growth data.")</div>
            <div class="row" style="margin-top: 8px">
                <button class="btn btnSecondary" type="button" @onclick="RetryLoad" disabled="@_retrying">@(_retrying ? "Retrying…" : "Retry")</button>
                <button class="btn btnGhost" type="button" @onclick="BackToGrowth">Back to Growth</button>
            </div>
        </div>
    </div>
}
else if (Growth is null || Goal is null)
{
    <div class="page">
        <h2 class="pageTitle">Growth Goal</h2>
        <div class="card pad">
            <div class="muted">@(string.IsNullOrEmpty(GoalId) ? "Missing route params." : "Goal not found.")</div>
            <div class="row">
                <button class="btn btnSecondary" type="button" @onclick="BackToGrowth">Back to Growth</button>
            </div>
        </div>
    </div>
}
else
{
    <div class="page">
        <div class="growthGoalHeader">
            <nav class="growthGoalBreadcrumbs" aria-label="Breadcrumbs">
                <a class="crumbLink" href="/team">Team</a>
                <span class="crumbSep" aria-hidden="true">/</span>
                <a class="crumbLink" href="@($"/team/{MemberId}")">@Member.Name</a>
                <span class="crumbSep" aria-hidden="true">/</span>
                <a class="crumbLink" href="@($"/team/{MemberId}/growth")">Growth</a>
                <span class="crumbSep" aria-hidden="true">/</span>
                <span class="crumbCurrent">Goal</span>
            </nav>

            <div class="growthGoalHeaderTop">
                <div class="growthGoalHeaderLeft">
                    <div class="growthGoalHeaderTitleRow">
                        <div class="growthGoalHeaderTitle">Goal: @Goal.Title</div>
                        <span class="pill @Tones.GoalStatusTone(Goal.Status)">@DisplayLabels.GoalStatusLabel(Goal.Status)</span>
                        <span class="pill toneNeutral">Priority: @(Goal.Priority?.ToString() ?? "Medium")</span>
                        <span class="pill toneNeutral">Category: @(Goal.Category ?? "—")</span>
                    </div>
                </div>
                <div class="growthGoalHeaderActions">
                    <button class="btn btnGhost" type="button" @onclick="BackToGrowth">Back to Growth</button>
                    <button class="btn btnSecondary" type="button" @onclick="AddAction">+ Add Action</button>
                    <button class="btn" type="button" @onclick="AddCheckIn">+ Add Check-in</button>
                </div>
            </div>
        </div>

        <div class="growthGoalDetailGrid">
            <div class="growthGoalLeft">
                <section class="card subtle" aria-label="Goal overview">
                    <div class="cardHeader">
                        <div class="cardTitle">GOAL OVERVIEW</div>
                        <div class="ggOverviewLastUpdated" title="@(Goal.LastUpdatedIso is not null ? $"Last updated: {Goal.LastUpdatedIso}" : null)">
                            <span class="ggOverviewLastUpdatedLabel">Last updated</span>
                            <span class="ggOverviewLastUpdatedValue">@FormatOverviewDate(Goal.LastUpdatedIso)</span>
                        </div>
                    </div>
                    <div class="pad">
                        <div class="ggMiniGrid">
                            <div class="ggMiniCard">
                                <div class="ggMiniHeader">
                                    <div class="ggMiniLabel">Timeframe</div>
                                    <button class="linkBtn" type="button" @onclick="() => _editTimeframe = !_editTimeframe">@(_editTimeframe ? "Done" : "Edit")</button>
                                </div>
                                @if (!_editTimeframe)
                                {
                                    <div class="ggMiniValue ggTimeframeLines">
                                        <div><span class="ggTimeframeKey">Start</span> <strong>@DisplayLabels.FormatDateLabel(Goal.StartDateIso)</strong></div>
                                        <div><span class="ggTimeframeKey">Target</span> <strong>@DisplayLabels.FormatDateLabel(Goal.TargetDateIso)</strong></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="ggMiniEditRow">
                                        <label class="field">
                                            <div class="fieldLabel">Start</div>
                                            <input class="input" type="date" value="@(Goal.StartDateIso ?? "")" @onchange="OnStartChange" />
                                        </label>
                                        <label class="field">
                                            <div class="fieldLabel">Target</div>
                                            <input class="input" type="date" value="@(Goal.TargetDateIso ?? "")" @onchange="OnTargetChange" />
                                        </label>
                                    </div>
                                }
                            </div>

                            <div class="ggMiniCard">
                                <div class="ggMiniHeader">
                                    <div class="ggMiniLabel">Status</div>
                                    <button class="linkBtn" type="button" @onclick="() => _editStatus = !_editStatus">@(_editStatus ? "Done" : "Edit")</button>
                                </div>
                                @if (!_editStatus)
                                {
                                    <div class="ggMiniValue">
                                        <span class="pill @Tones.GoalStatusTone(Goal.Status)">@DisplayLabels.GoalStatusLabel(Goal.Status)</span>
                                    </div>
                                }
                                else
                                {
                                    <label class="field">
                                        <div class="fieldLabel">Status</div>
                                        <select class="select" value="@Goal.Status" @onchange="OnStatusChange">
                                            <option value="OnTrack">On Track</option>
                                            <option value="NeedsAttention">Needs Attention</option>
                                            <option value="Completed">Completed</option>
                                        </select>
                                    </label>
                                }
                            </div>

                            <div class="ggMiniCard">
                                <div class="ggMiniHeader">
                                    <div class="ggMiniLabel">Priority</div>
                                    <button class="linkBtn" type="button" @onclick="() => _editPriority = !_editPriority">@(_editPriority ? "Done" : "Edit")</button>
                                </div>
                                @if (!_editPriority)
                                {
                                    <div class="ggMiniValue"><strong>@(Goal.Priority?.ToString() ?? "Medium")</strong></div>
                                }
                                else
                                {
                                    <label class="field">
                                        <div class="fieldLabel">Priority</div>
                                        <select class="select" value="@(Goal.Priority?.ToString() ?? "Medium")" @onchange="OnPriorityChange">
                                            <option value="Low">Low</option>
                                            <option value="Medium">Medium</option>
                                            <option value="High">High</option>
                                            <option value="Critical">Critical</option>
                                        </select>
                                    </label>
                                }
                            </div>

                            <div class="ggMiniCard">
                                <div class="ggMiniHeader">
                                    <div class="ggMiniLabel">Category</div>
                                    <button class="linkBtn" type="button" @onclick="() => _editCategory = !_editCategory">@(_editCategory ? "Done" : "Edit")</button>
                                </div>
                                @if (!_editCategory)
                                {
                                    <div class="ggMiniValue">
                                        @if (string.IsNullOrWhiteSpace(Goal.Category))
                                        {
                                            <span class="muted">—</span>
                                        }
                                        else
                                        {
                                            <strong>@Goal.Category</strong>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <label class="field">
                                        <div class="fieldLabel">Category</div>
                                        <input class="input" value="@(Goal.Category ?? "")" maxlength="@GrowthUiHelpers.MaxGoalCategory" placeholder="e.g. Leadership" @oninput="OnCategoryInput" />
                                    </label>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_goalValidationError))
                        {
                            <div class="mutedSmall" style="color: var(--danger, #c0392b)">@_goalValidationError</div>
                        }

                        <div class="ggBlock">
                            <div class="ggBlockHeader">
                                <div class="ggBlockTitle">Progress</div>
                            </div>
                            <div class="ggProgressText">
                                <strong>@ProgressPercent%</strong> (based on actions completed) • @ProgressDone/@ProgressTotal complete
                            </div>
                            <div class="ggProgressBar" aria-hidden="true">
                                <div class="ggProgressFill" style="width: @(ProgressPercent)%"></div>
                            </div>
                        </div>

                        <div class="ggBlock">
                            <div class="ggBlockHeader">
                                <div class="ggBlockTitle">Summary</div>
                                <button class="linkBtn" type="button" @onclick="() => _editSummary = !_editSummary">@(_editSummary ? "Done" : "Edit")</button>
                            </div>
                            @if (!_editSummary)
                            {
                                <div class="ggBlockBody">
                                    @if (string.IsNullOrWhiteSpace(Goal.Summary))
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else
                                    {
                                        @Goal.Summary
                                    }
                                </div>
                            }
                            else
                            {
                                <textarea class="textarea" value="@(Goal.Summary ?? "")" maxlength="@GrowthUiHelpers.MaxGoalDescription" placeholder="Short paragraph describing the goal and why it matters…" @oninput="OnSummaryInput"></textarea>
                            }
                        </div>

                        <div class="ggBlock">
                            <div class="ggBlockHeader">
                                <div class="ggBlockTitle">Success Criteria</div>
                                <button class="linkBtn" type="button" @onclick="() => _editSuccessCriteria = !_editSuccessCriteria">@(_editSuccessCriteria ? "Done" : "Edit")</button>
                            </div>
                            @if (!_editSuccessCriteria)
                            {
                                @if (Goal.SuccessCriteria.Count == 0)
                                {
                                    <div class="ggBlockBody muted">—</div>
                                }
                                else
                                {
                                    <ul class="ggBullets">
                                        @foreach (string criterion in Goal.SuccessCriteria)
                                        {
                                            <li>@criterion</li>
                                        }
                                    </ul>
                                }
                            }
                            else
                            {
                                <textarea class="textarea" value="@string.Join('\n', Goal.SuccessCriteria)" maxlength="@GrowthUiHelpers.MaxSuccessCriteriaAggregate" placeholder="One bullet per line…" @oninput="OnCriteriaInput"></textarea>
                            }
                        </div>
                    </div>
                </section>

                <section class="growthGoalSection" aria-label="Actions and milestones">
                    <div class="growthGoalSectionTitleRow">
                        <div class="growthGoalSectionTitle">ACTIONS &amp; MILESTONES</div>
                        <div class="ggControlsRow" aria-label="Actions controls">
                            <label class="ggControl">
                                <span class="ggControlLabel">Filter</span>
                                <select class="select selectCompact" @bind="_actionFilter">
                                <option value="All">All</option>
                                <option value="Planned">Planned</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Complete">Complete</option>
                                </select>
                            </label>
                            <label class="ggControl">
                                <span class="ggControlLabel">Sort</span>
                                <select class="select selectCompact" @bind="_actionSort">
                                <option value="DueDate">Due date</option>
                                <option value="State">State</option>
                                </select>
                            </label>
                        </div>
                    </div>
                    <div class="card subtle">
                        <div class="ggTable" role="table" aria-label="Actions table">
                            <div class="ggRow ggHeaderRow" role="row">
                                <div class="ggCell ggCellDone" role="columnheader">Done</div>
                                <div class="ggCell ggCellMain" role="columnheader">Action</div>
                                <div class="ggCell ggCellDue" role="columnheader">Due</div>
                                <div class="ggCell ggCellState" role="columnheader">State</div>
                            </div>
                            @if (VisibleActions.Count == 0)
                            {
                                <div class="pad muted">No actions yet. Use "Add Action" to create one.</div>
                            }
                            else
                            {
                                @foreach (GrowthGoalAction a in VisibleActions)
                                {
                                    GrowthGoalAction action = a;
                                    string notesPreview = GetNotesPreview(action.Notes);
                                    bool done = action.State == GrowthGoalActionState.Complete;
                                    <button type="button"
                                            class="ggRow ggRowBtn @(_selectedActionId == action.Id ? "ggRowSelected" : null)"
                                            role="row"
                                            @onclick="() => SelectAction(action.Id)">
                                        <div class="ggCell ggCellDone" role="cell" @onclick:stopPropagation="true">
                                            <input type="checkbox"
                                                   checked="@done"
                                                   @onchange="e => OnActionDoneToggle(action.Id, e)" />
                                        </div>
                                        <div class="ggCell ggCellMain" role="cell">
                                            <div class="ggPrimary">@action.Title</div>
                                            @if (!string.IsNullOrEmpty(notesPreview))
                                            {
                                                <div class="ggRowSubtle">Notes: @notesPreview</div>
                                            }
                                        </div>
                                        <div class="ggCell ggCellDue" role="cell">
                                            <div class="ggMuted">@DisplayLabels.FormatIsoDateShort(action.DueDateIso)</div>
                                        </div>
                                        <div class="ggCell ggCellState" role="cell">
                                            <span class="pill @Tones.ActionStateTone(action.State)">@ActionStateLabel(action.State)</span>
                                        </div>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </section>

                <section class="growthGoalSection" aria-label="Check-ins">
                    <div class="growthGoalSectionTitleRow">
                        <div class="growthGoalSectionTitle">CHECK-INS</div>
                        <div class="mutedSmall">Brief notes on how it's going • Click to edit on the right</div>
                    </div>
                    <div class="card subtle">
                        <div class="ggTable" role="table" aria-label="Check-ins table">
                            <div class="ggRow ggRow3 ggHeaderRow" role="row">
                                <div class="ggCell ggCellDate" role="columnheader">Date</div>
                                <div class="ggCell ggCellMain" role="columnheader">Note</div>
                                <div class="ggCell ggCellSignal" role="columnheader">Signal</div>
                            </div>
                            @if (Goal.CheckIns.Count == 0)
                            {
                                <div class="pad muted">No check-ins yet. Use "Add Check-in" to add one.</div>
                            }
                            else
                            {
                                @foreach (GrowthGoalCheckIn c in Goal.CheckIns)
                                {
                                    GrowthGoalCheckIn checkIn = c;
                                    <button type="button"
                                            class="ggRow ggRow3 ggRowBtn @(_selectedCheckInId == checkIn.Id ? "ggRowSelected" : null)"
                                            role="row"
                                            @onclick="() => SelectCheckIn(checkIn.Id)">
                                        <div class="ggCell ggCellDate" role="cell">
                                            <div class="ggMuted">@DisplayLabels.FormatDateLabel(checkIn.DateIso)</div>
                                        </div>
                                        <div class="ggCell ggCellMain" role="cell">
                                            <div class="ggPrimary">@(string.IsNullOrEmpty(checkIn.Note) ? "—" : GetCheckInPreview(checkIn.Note))</div>
                                        </div>
                                        <div class="ggCell ggCellSignal" role="cell">
                                            <span class="pill @Tones.CheckInSignalTone(checkIn.Signal)">@checkIn.Signal</span>
                                        </div>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </section>
            </div>

            <aside class="growthGoalRight" aria-label="Detail editor">
                <section class="card subtle ggEditorCard">
                    <div class="cardHeader">
                        <div class="cardTitle">DETAIL EDITOR</div>
                        <div class="mutedSmall">Selection-based editing</div>
                    </div>
                    <div class="pad">
                        @if (_selectedActionId is not null && SelectedAction is null)
                        {
                            <div class="muted">Action not found.</div>
                        }
                        else if (_selectedCheckInId is not null && SelectedCheckIn is null)
                        {
                            <div class="muted">Check-in not found.</div>
                        }
                        else if (SelectedAction is null && SelectedCheckIn is null)
                        {
                            <div class="ggEditorCallout">
                                Click an Action/Milestone or Check-in on the left to edit it here. This keeps the main page scannable without lots of nested cards.
                            </div>
                            <div class="muted">Select an action or check-in from the left to edit it.</div>
                        }
                        else if (SelectedAction is not null)
                        {
                            <div class="fieldGrid" aria-label="Action editor">
                                <div class="ggEditorSelectedPillRow">
                                    <span class="pill toneNeutral">Selected: Action</span>
                                </div>
                                <label class="field">
                                    <div class="fieldLabel">Title</div>
                                    <input class="input" value="@SelectedAction.Title" maxlength="@GrowthUiHelpers.MaxActionTitle" @oninput="OnActionTitleInput" />
                                </label>
                                <div class="fieldGrid2">
                                    <label class="field">
                                        <div class="fieldLabel">State</div>
                                        <select class="select" value="@SelectedAction.State" @onchange="OnActionStateChange">
                                            <option value="Planned">Planned</option>
                                            <option value="InProgress">In Progress</option>
                                            <option value="Complete">Complete</option>
                                        </select>
                                    </label>
                                    <label class="field">
                                        <div class="fieldLabel">Due date</div>
                                        <input class="input" type="date" value="@(SelectedAction.DueDateIso ?? "")" @onchange="OnActionDueChange" />
                                    </label>
                                    <label class="field">
                                        <div class="fieldLabel">Priority</div>
                                        <select class="select" value="@(SelectedAction.Priority?.ToString() ?? "Medium")" @onchange="OnActionPriorityChange">
                                            <option value="Low">Low</option>
                                            <option value="Medium">Medium</option>
                                            <option value="High">High</option>
                                            <option value="Critical">Critical</option>
                                        </select>
                                    </label>
                                </div>
                                <label class="field">
                                    <div class="fieldLabel">Notes (what you're tracking)</div>
                                    <textarea class="textarea" value="@(SelectedAction.Notes ?? "")" maxlength="@GrowthUiHelpers.MaxActionNotes" placeholder="Free-text notes..." @oninput="OnActionNotesInput"></textarea>
                                    @if (!string.IsNullOrEmpty(_actionValidationError))
                                    {
                                        <div class="mutedSmall" style="margin-top: 4px; color: var(--danger, #c0392b)">@_actionValidationError</div>
                                    }
                                </label>
                                <label class="field">
                                    <div class="fieldLabel">Evidence / Links (optional)</div>
                                    <textarea class="textarea" value="@string.Join('\n', SelectedAction.Links)" maxlength="@GrowthUiHelpers.MaxActionEvidence" placeholder="https://..." @oninput="OnActionLinksInput"></textarea>
                                </label>
                            </div>
                        }
                        else if (SelectedCheckIn is not null)
                        {
                            <div class="fieldGrid" aria-label="Check-in editor">
                                <div class="ggEditorSelectedPillRow">
                                    <span class="pill toneNeutral">Selected: Check-in</span>
                                </div>
                                <div class="fieldGrid2">
                                    <label class="field">
                                        <div class="fieldLabel">Date</div>
                                        <input class="input" type="date" value="@SelectedCheckIn.DateIso" @onchange="OnCheckInDateChange" />
                                    </label>
                                    <label class="field">
                                        <div class="fieldLabel">Signal</div>
                                        <select class="select" value="@SelectedCheckIn.Signal" @onchange="OnCheckInSignalChange">
                                            <option value="Positive">Positive</option>
                                            <option value="Mixed">Mixed</option>
                                            <option value="Concern">Concern</option>
                                        </select>
                                    </label>
                                </div>
                                <label class="field">
                                    <div class="fieldLabel">Check-in Note</div>
                                    <textarea class="textarea" value="@SelectedCheckIn.Note" maxlength="@GrowthUiHelpers.MaxCheckInNote" placeholder="Short narrative signal about how the goal is going..." @oninput="OnCheckInNoteInput"></textarea>
                                    @if (!string.IsNullOrEmpty(_checkInValidationError))
                                    {
                                        <div class="mutedSmall" style="margin-top: 4px; color: var(--danger, #c0392b)">@_checkInValidationError</div>
                                    }
                                </label>
                            </div>
                        }
                    </div>
                </section>
            </aside>

        </div>
    </div>
}
