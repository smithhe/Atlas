@page "/team"
@page "/team/{MemberId}"
@page "/team/{MemberId}/notes"
@page "/team/{MemberId}/work-items"
@page "/team/{MemberId}/risks"
@page "/team/{MemberId}/growth"
<PageTitle>Team — Atlas</PageTitle>

<div class="page">
    @if (this.IsFocusMode && MemberIdParsed is { } mid)
    {
        <nav class="pageBreadcrumbs" aria-label="Breadcrumbs">
            <a class="crumbLink" href="/team">Team</a>
            <span class="crumbSep" aria-hidden="true">/</span>
            @if (ActiveTab == MemberTab.Overview)
            {
                <span class="crumbCurrent">@(Member?.Name ?? MemberId)</span>
            }
            else
            {
                <a class="crumbLink" href="@($"/team/{mid}")">@(Member?.Name ?? MemberId)</a>
                <span class="crumbSep" aria-hidden="true">/</span>
                <span class="crumbCurrent">@TabLabel(ActiveTab)</span>
            }
        </nav>
    }

    <h2 class="pageTitle">Team</h2>

    <div class="teamGrid @(this.IsFocusMode ? "teamGridFocus" : null)">
        @if (!this.IsFocusMode)
        {
            <section class="pane paneTeamLeft" aria-label="Team member list">
                <div class="list listCard">
                    @if (this._cache.Team.Count == 0)
                    {
                        <div class="muted pad">
                            No team members yet. Import from
                            <a class="crumbLink" href="/setup">Azure Setup</a>
                            or
                            <a class="crumbLink" href="/settings/azure-import">Settings → Azure Import</a>.
                        </div>
                    }
                    else
                    {
                        @foreach (TeamMember m in this._cache.Team.OrderBy(x => x.Name))
                        {
                            Guid id = m.Id;
                            <button @key="id"
                                    type="button"
                                    class="listRow listRowBtn @(id == this._selection.SelectedTeamMemberId ? "listRowActive" : null)"
                                    @onclick="() => SelectFromList(id)"
                                    @ondblclick="() => GoFocus(id)">
                                <div class="listMain">
                                    <div class="listTitle">@m.Name</div>
                                    <div class="listMeta">@(m.Role ?? "—")</div>
                                </div>
                                <span class="dot dot-@(m.StatusDot.ToLowerInvariant())" aria-label="@($"{m.StatusDot} status")"></span>
                            </button>
                        }
                    }
                </div>
            </section>
        }

        <section class="pane paneTeamCenter" aria-label="Member detail">
            @if (this.Selected is null)
            {
                <div class="card pad">
                    <div class="muted">
                        @if (this._cache.Team.Count == 0)
                        {
                            <text>
                                No team members yet. Import from
                                <a class="crumbLink" href="/setup">Azure Setup</a>
                                or
                                <a class="crumbLink" href="/settings/azure-import">Settings → Azure Import</a>.
                            </text>
                        }
                        else if (this.IsFocusMode && this._cache.TeamReady)
                        {
                            <text>Member not found. Redirecting…</text>
                        }
                        else if (this.IsFocusMode)
                        {
                            <text>Loading member…</text>
                        }
                        else
                        {
                            <text>Select a team member.</text>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card pad">
                    <div class="detailHeader">
                        <div>
                            <div class="detailTitle">@this.Selected.Name</div>
                            <div class="mutedSmall">@(this.Selected.Role ?? "")</div>
                        </div>
                        @if (this.IsFocusMode)
                        {
                            <button class="btn btnGhost" type="button" @onclick="ExitFocus">Exit focus</button>
                        }
                        else
                        {
                            <button class="btn btnGhost" type="button" @onclick="EnterFocus">Focus</button>
                        }
                    </div>

                    <div class="tabsBar" role="tablist" aria-label="Member tabs">
                        @if (this.IsFocusMode)
                        {
                            <NavLink class="tabBtn" ActiveClass="tabBtnActive" href="@($"/team/{this.Selected.Id}")" Match="NavLinkMatch.All">Overview</NavLink>
                            <NavLink class="tabBtn" ActiveClass="tabBtnActive" href="@($"/team/{this.Selected.Id}/notes")">Notes</NavLink>
                            <NavLink class="tabBtn" ActiveClass="tabBtnActive" href="@($"/team/{this.Selected.Id}/work-items")">Work Items</NavLink>
                            <NavLink class="tabBtn" ActiveClass="tabBtnActive" href="@($"/team/{this.Selected.Id}/risks")">Risks</NavLink>
                            <NavLink class="tabBtn" ActiveClass="tabBtnActive" href="@($"/team/{this.Selected.Id}/growth")">Growth</NavLink>
                        }
                        else
                        {
                            <button type="button" class="tabBtn @(this.LocalTab == MemberTab.Overview ? "tabBtnActive" : null)" @onclick="() => this.LocalTab = MemberTab.Overview">Overview</button>
                            <button type="button" class="tabBtn @(this.LocalTab == MemberTab.Notes ? "tabBtnActive" : null)" @onclick="() => this.LocalTab = MemberTab.Notes">Notes</button>
                            <button type="button" class="tabBtn @(this.LocalTab == MemberTab.WorkItems ? "tabBtnActive" : null)" @onclick="() => this.LocalTab = MemberTab.WorkItems">Work Items</button>
                            <button type="button" class="tabBtn @(this.LocalTab == MemberTab.Risks ? "tabBtnActive" : null)" @onclick="() => this.LocalTab = MemberTab.Risks">Risks</button>
                            <button type="button" class="tabBtn @(this.LocalTab == MemberTab.Growth ? "tabBtnActive" : null)" @onclick="() => this.LocalTab = MemberTab.Growth">Growth</button>
                        }
                    </div>

                    @switch (ActiveTab)
                    {
                        case MemberTab.Overview:
                            <MemberOverviewTab Member="this.Selected" OnUpdate="HandleMemberUpdate" OnGoToNotes="GoNotes" OnGoToWorkItem="GoWorkItem" />
                            break;
                        case MemberTab.Notes:
                            <MemberNotesTab Member="this.Selected" />
                            break;
                        case MemberTab.WorkItems:
                            <MemberWorkItemsTab Member="this.Selected" />
                            break;
                        case MemberTab.Risks:
                            <MemberRisksTab MemberId="this.Selected.Id" />
                            break;
                        case MemberTab.Growth:
                            <MemberGrowthTab Member="this.Selected" />
                            break;
                    }
                </div>
            }
        </section>
    </div>
</div>
