@page "/team"
@page "/team/{MemberId}"
@page "/team/{MemberId}/notes"
@page "/team/{MemberId}/notes/{NoteId}"
@page "/team/{MemberId}/work-items"
@page "/team/{MemberId}/work-items/{WorkItemId}"
@page "/team/{MemberId}/risks"
@page "/team/{MemberId}/risks/{TeamMemberRiskId}"
@page "/team/{MemberId}/growth"
@page "/team/{MemberId}/growth/goals/{GoalId}"

<PageTitle>Team — Atlas</PageTitle>

<div class="page">
    <h2 class="pageTitle">Team</h2>
    <div class="muted">
        @if (string.IsNullOrEmpty(MemberId))
        {
            <span>Team hub stub (Phase 6).</span>
        }
        else
        {
            <span>Team member stub for @MemberId (Phase 6).</span>
        }
    </div>
</div>

@code {
    [Parameter] public string? MemberId { get; set; }
    [Parameter] public string? NoteId { get; set; }
    [Parameter] public string? WorkItemId { get; set; }
    [Parameter] public string? TeamMemberRiskId { get; set; }
    [Parameter] public string? GoalId { get; set; }
}
