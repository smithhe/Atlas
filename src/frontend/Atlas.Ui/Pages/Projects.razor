@page "/projects"
@page "/projects/{ProjectId}"
<PageTitle>Projects — Atlas</PageTitle>

<div class="page pageFill">
    <PageTitleRow Title="Projects" AddLabel="Add project" AddingLabel="Adding…" Adding="_creating" OnAdd="HandleAddProject" />

    <div class="splitGrid splitGridFill @(IsFocusMode ? "projectsSplitFocus" : null)">
        @if (!IsFocusMode)
        {
            <section class="pane paneLeft" aria-label="Project list">
                <div class="list listCard">
                    @foreach (Project p in Cache.Projects)
                    {
                        Guid projectId = p.Id;
                        string projectName = p.Name;
                        string projectSummary = p.Summary;
                        <button type="button"
                                class="listRow listRowBtn @(projectId == Selection.SelectedProjectId ? "listRowActive" : null)"
                                @onclick="() => SelectFromList(projectId)"
                                @ondblclick="() => GoFocus(projectId)">
                            <div class="listMain">
                                <div class="listTitle">@projectName</div>
                                <div class="listMeta">@projectSummary</div>
                            </div>
                        </button>
                    }
                </div>
            </section>
        }

        <section class="pane paneCenter" aria-label="Project detail">
            @if (Selected is null)
            {
                <div class="card pad"><div class="muted">Select a project.</div></div>
            }
            else
            {
                <div class="card pad projectDetailCard" aria-label="Project detail">
                    <div class="projectHeader">
                        <div class="projectHeaderLeft">
                            <div class="projectTitle">@Selected.Name</div>
                        </div>
                        <div class="projectHeaderRight">
                            @if (!_editing)
                            {
                                <div class="pillRow projectHeaderPills" aria-label="Project status summary">
                                    @if (Selected.Status is not null)
                                    {
                                        <span class="pill @Tones.ProjectStatusTone(Selected.Status.ToString())">Status: @Selected.Status</span>
                                    }
                                    @if (Selected.Health is not null)
                                    {
                                        <span class="pill @Tones.HealthTone(Selected.Health)">Health: @Selected.Health</span>
                                    }
                                    @if (!string.IsNullOrEmpty(Selected.TargetDateIso))
                                    {
                                        <span class="pill toneNeutral">Target: @DisplayLabels.FormatDateLabel(Selected.TargetDateIso)</span>
                                    }
                                    @if (Selected.Priority is not null)
                                    {
                                        <span class="pill @Tones.PriorityTone(Selected.Priority)">Priority: @Selected.Priority</span>
                                    }
                                </div>
                            }
                            <div class="rowTiny projectHeaderActions" aria-label="Project focus actions">
                                @if (EffectiveTab == "overview")
                                {
                                    @if (_editing)
                                    {
                                        <button class="btn btnSecondary" type="button" @onclick="SaveOverview" disabled="@_saving">Save</button>
                                        <button class="btn btnGhost" type="button" @onclick="CancelEdit">Cancel</button>
                                    }
                                    else
                                    {
                                        <button class="btn btnGhost" type="button" @onclick="StartEdit">Edit</button>
                                    }
                                }
                                @if (IsFocusMode)
                                {
                                    <button class="btn btnGhost" type="button" @onclick="ExitFocus">Exit focus</button>
                                }
                                else
                                {
                                    <button class="btn btnGhost" type="button" @onclick="EnterFocus">Focus</button>
                                }
                                <button class="btn btnGhost textBad" type="button" @onclick="HandleDelete" disabled="@_deleting">
                                    @(_deleting ? "Deleting…" : "Delete")
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (!_editing)
                    {
                        <div class="tabsBar projectTabsBar" aria-label="Project tabs">
                            <button class="tabBtn @(_tab == "overview" ? "tabBtnActive" : null)" type="button" @onclick='() => SetTab("overview")'>Overview</button>
                            <button class="tabBtn @(_tab == "tasks" ? "tabBtnActive" : null)" type="button" @onclick='() => SetTab("tasks")'>Tasks</button>
                            <button class="tabBtn @(_tab == "risks" ? "tabBtnActive" : null)" type="button" @onclick='() => SetTab("risks")'>Risks</button>
                        </div>
                    }

                    <div class="projectDetailScroll" aria-label="Project detail scroll region">
                        @if (EffectiveTab == "overview")
                        {
                            <div class="projectOverviewGrid @(_editing ? "projectOverviewGridEditing" : null)" aria-label="Project overview">
                                @if (_editing)
                                {
                                    <section class="card subtle projectOverviewSection span2" aria-label="Edit overview">
                                        <div class="cardHeader"><div class="cardTitle">Edit Overview</div></div>
                                        <div class="pad">
                                            <div class="fieldGrid2">
                                                <label class="field span2">
                                                    <div class="fieldLabel">Name</div>
                                                    <input class="input" @bind="_draftName" @bind:event="oninput" />
                                                </label>
                                                <label class="field">
                                                    <div class="fieldLabel">Status</div>
                                                    <select class="select" @bind="_draftStatus">
                                                        <option value="Active">Active</option>
                                                        <option value="Paused">Paused</option>
                                                        <option value="Completed">Completed</option>
                                                    </select>
                                                </label>
                                                <label class="field">
                                                    <div class="fieldLabel">Health</div>
                                                    <select class="select" @bind="_draftHealth">
                                                        <option value="Green">Green</option>
                                                        <option value="Yellow">Yellow</option>
                                                        <option value="Red">Red</option>
                                                    </select>
                                                </label>
                                                <label class="field">
                                                    <div class="fieldLabel">Target</div>
                                                    <input class="input" type="date" value="@_draftTargetDateIso" @onchange="OnDraftTargetDateChange" />
                                                </label>
                                                <label class="field">
                                                    <div class="fieldLabel">Priority</div>
                                                    <select class="select" value="@(_draftPriority ?? "Medium")" @onchange="OnDraftPriorityChange">
                                                        <option value="Low">Low</option>
                                                        <option value="Medium">Medium</option>
                                                        <option value="High">High</option>
                                                        <option value="Critical">Critical</option>
                                                    </select>
                                                </label>
                                                <label class="field">
                                                    <div class="fieldLabel">Product Owner</div>
                                                    <select class="select" @bind="_draftProductOwnerId">
                                                        <option value="">(None)</option>
                                                        @foreach (ProductOwner po in SortedProductOwners)
                                                        {
                                                            <option value="@po.Id">@po.Name</option>
                                                        }
                                                    </select>
                                                </label>
                                                <label class="field span2">
                                                    <div class="fieldLabel">Tags (comma separated)</div>
                                                    <input class="input" placeholder="platform, reliability" @bind="_tagsText" @bind:event="oninput" />
                                                </label>
                                                <label class="field span2">
                                                    <div class="fieldLabel">Description</div>
                                                    <textarea class="textarea" @bind="_draftDescription" @bind:event="oninput"></textarea>
                                                </label>
                                                <label class="field span2">
                                                    <div class="fieldLabel">Summary</div>
                                                    <textarea class="textarea" @bind="_draftSummary" @bind:event="oninput"></textarea>
                                                </label>
                                                <label class="field">
                                                    <div class="fieldLabel">Latest check-in date</div>
                                                    <input class="input" type="date" value="@_draftCheckInDate" @onchange="OnDraftCheckInDateChange" />
                                                </label>
                                                <label class="field span2">
                                                    <div class="fieldLabel">Latest check-in note</div>
                                                    <textarea class="textarea" @bind="_draftCheckInNote" @bind:event="oninput"></textarea>
                                                </label>
                                                <div class="field span2">
                                                    <div class="fieldLabel">Links</div>
                                                    <div style="display: flex; flex-direction: column; gap: 8px;">
                                                        @for (int i = 0; i < _draftLinks.Count; i++)
                                                        {
                                                            int idx = i;
                                                            ProjectLink link = _draftLinks[idx];
                                                            <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 8px;">
                                                                <input class="input inputInline" placeholder="Label" value="@link.Label" @oninput="e => UpdateLinkLabel(idx, e.Value?.ToString())" />
                                                                <input class="input inputInline" placeholder="URL" value="@link.Url" @oninput="e => UpdateLinkUrl(idx, e.Value?.ToString())" />
                                                                <button type="button" class="btn btnGhost btnIcon" title="Remove link" @onclick="() => RemoveLink(idx)">×</button>
                                                            </div>
                                                        }
                                                        <button type="button" class="btn btnGhost" @onclick="AddLink">+ Add link</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                }
                                else
                                {
                                    <section class="card subtle projectOverviewSection" aria-label="Summary">
                                        <div class="cardHeader"><div class="cardTitle">Summary</div></div>
                                        <div class="pad projectOverviewBody">@Selected.Summary</div>
                                    </section>
                                    <section class="card subtle projectOverviewSection" aria-label="Details">
                                        <div class="cardHeader"><div class="cardTitle">Details</div></div>
                                        <div class="pad projectDetailsKv">
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">Product Owner</div>
                                                <div class="projectDetailsVal">@(ProductOwner?.Name ?? "—")</div>
                                            </div>
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">Team members</div>
                                                <div class="projectDetailsVal">@(TeamMembers.Count > 0 ? string.Join(", ", TeamMembers.Select(m => m.Name)) : "—")</div>
                                            </div>
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">Tags</div>
                                                <div class="projectDetailsVal">
                                                    <div class="pillRow">
                                                        @if (Selected.Tags.Count > 0)
                                                        {
                                                            @foreach (string tag in Selected.Tags)
                                                            {
                                                                <span class="pill toneNeutral">@tag</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="muted">—</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">Last updated</div>
                                                <div class="projectDetailsVal">
                                                    @(string.IsNullOrEmpty(Selected.LastUpdatedIso) ? "—" : DisplayLabels.FormatDateLabel(Selected.LastUpdatedIso.Length >= 10 ? Selected.LastUpdatedIso[..10] : Selected.LastUpdatedIso))
                                                </div>
                                            </div>
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">Links</div>
                                                <div class="projectDetailsVal">
                                                    @if (Selected.Links.Count > 0)
                                                    {
                                                        <span class="mutedSmall">@string.Join(" • ", Selected.Links.Select(l => l.Label))</span>
                                                    }
                                                    else
                                                    {
                                                        @:—
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                    <section class="card subtle projectOverviewSection" aria-label="Latest check-in">
                                        <div class="cardHeader"><div class="cardTitle">Latest Check-in</div></div>
                                        <div class="pad">
                                            <div class="mutedSmall">
                                                @(string.IsNullOrEmpty(Selected.LatestCheckIn?.DateIso) ? "—" : DisplayLabels.FormatDateLabel(Selected.LatestCheckIn.DateIso))
                                            </div>
                                            <div class="projectOverviewBody">@(Selected.LatestCheckIn?.Note ?? "—")</div>
                                        </div>
                                    </section>
                                    <section class="card subtle projectOverviewSection" aria-label="Rollup">
                                        <div class="cardHeader"><div class="cardTitle">Rollup</div></div>
                                        <div class="pad projectDetailsKv">
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">Tasks complete</div>
                                                <div class="projectDetailsVal">
                                                    <span class="pill toneNeutral">@Rollup.DoneTasks / @Rollup.TotalTasks</span>
                                                </div>
                                            </div>
                                            <div class="mutedSmall">
                                                Local: @Rollup.LocalDoneTasks / @Rollup.LocalTotalTasks | Imported: @Rollup.ImportedDoneTasks / @Rollup.ImportedTotalTasks
                                            </div>
                                            <div class="ggProgressBar" aria-label="Task completion progress">
                                                <div class="ggProgressFill" style="width: @(Rollup.TaskCompletionPct)%"></div>
                                            </div>
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">Open tasks</div>
                                                <div class="projectDetailsVal">
                                                    <span class="pill toneNeutral">@Rollup.OpenTasks</span>
                                                </div>
                                            </div>
                                            <div class="mutedSmall">
                                                Local: @Rollup.LocalOpenTasks | Imported: @Rollup.ImportedOpenTasks
                                            </div>
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">High priority</div>
                                                <div class="projectDetailsVal">
                                                    <span class="pill @(Rollup.HighPriorityOpenTasks > 0 ? "toneWarn" : "toneNeutral")">@Rollup.HighPriorityOpenTasks</span>
                                                </div>
                                            </div>
                                            <div class="mutedSmall">Local tasks only (Azure imports do not include priority today).</div>
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">Open risks</div>
                                                <div class="projectDetailsVal">
                                                    <span class="pill @(Rollup.OpenRisks > 0 ? "toneBad" : "toneGood")">@Rollup.OpenRisks</span>
                                                </div>
                                            </div>
                                            <div class="projectDetailsRow">
                                                <div class="projectDetailsKey">At risk</div>
                                                <div class="projectDetailsVal">
                                                    <span class="pill @(Rollup.AtRiskCount > 0 ? "toneWarn" : "toneGood")">@Rollup.AtRiskCount</span>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                }
                            </div>
                        }

                        @if (!_editing && _tab == "tasks")
                        {
                            <div class="projectTabBody" aria-label="Project tasks tab">
                                <section class="card subtle projectTabSection" aria-label="Task filters">
                                    <div class="pad projectFiltersRow">
                                        <label class="field">
                                            <div class="fieldLabel">Search</div>
                                            <input class="input" placeholder="Filter tasks…" @bind="_taskQuery" @bind:event="oninput" />
                                        </label>
                                        <label class="field">
                                            <div class="fieldLabel">Status</div>
                                            <select class="select selectCompact" @bind="_taskStatusFilter">
                                                <option value="All">All</option>
                                                <option value="Not Started">Not Started</option>
                                                <option value="In Progress">In Progress</option>
                                                <option value="Blocked">Blocked</option>
                                                <option value="Done">Done</option>
                                            </select>
                                        </label>
                                        <label class="field">
                                            <div class="fieldLabel">Priority</div>
                                            <select class="select selectCompact" @bind="_taskPriorityFilter">
                                                <option value="All">All</option>
                                                <option value="Low">Low</option>
                                                <option value="Medium">Medium</option>
                                                <option value="High">High</option>
                                                <option value="Critical">Critical</option>
                                            </select>
                                        </label>
                                        <label class="field">
                                            <div class="fieldLabel">Assignee</div>
                                            <select class="select selectCompact" @bind="_taskAssigneeFilter">
                                                <option value="All">All</option>
                                                @foreach (AssigneeOption o in TaskAssigneeOptions)
                                                {
                                                    <option value="@o.Id">@o.Name</option>
                                                }
                                            </select>
                                        </label>
                                        <label class="field">
                                            <div class="fieldLabel">Due</div>
                                            <select class="select selectCompact" @bind="_taskDueFilter">
                                                <option value="All">All</option>
                                                <option value="Overdue">Overdue</option>
                                                <option value="Next 7 days">Next 7 days</option>
                                                <option value="Next 30 days">Next 30 days</option>
                                                <option value="No due date">No due date</option>
                                            </select>
                                        </label>
                                    </div>
                                </section>
                                <section class="card subtle projectTabSection" aria-label="Linked tasks">
                                    <div class="cardHeader"><div class="cardTitle">Linked Tasks</div></div>
                                    <div class="projectTable" role="table" aria-label="Project tasks table">
                                        <div class="projectTableHeader" role="row">
                                            <div class="projectTh" role="columnheader">Status</div>
                                            <div class="projectTh" role="columnheader">Task</div>
                                            <div class="projectTh" role="columnheader">Priority</div>
                                            <div class="projectTh" role="columnheader">Assignee</div>
                                            <div class="projectTh" role="columnheader">Due</div>
                                        </div>
                                        @if (FilteredTasks.Count > 0)
                                        {
                                            @foreach (AtlasTask t in FilteredTasks)
                                            {
                                                Guid taskId = t.Id;
                                                <button type="button" class="projectTableRow projectTableRowBtn" role="row" title="Open task in focus mode" @onclick="() => GoTask(taskId)">
                                                    <div class="projectTd" role="cell">
                                                        <span class="pill @Tones.TaskStatusTone(t.Status)">@DisplayLabels.FormatTaskStatus(t.Status)</span>
                                                    </div>
                                                    <div class="projectTd" role="cell">
                                                        <div class="projectCellTitle">@t.Title</div>
                                                    </div>
                                                    <div class="projectTd" role="cell">@t.Priority</div>
                                                    <div class="projectTd" role="cell">@FormatAssignee(t.AssigneeId)</div>
                                                    <div class="projectTd" role="cell">@(string.IsNullOrEmpty(t.DueDate) ? "—" : DisplayLabels.FormatDateLabel(t.DueDate))</div>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="muted pad">No tasks match your filters.</div>
                                        }
                                    </div>
                                </section>
                            </div>
                        }

                        @if (!_editing && _tab == "risks")
                        {
                            <div class="projectTabBody" aria-label="Project risks tab">
                                <section class="card subtle projectTabSection" aria-label="Risk filters">
                                    <div class="pad projectFiltersRow projectFiltersRowRisks">
                                        <label class="field">
                                            <div class="fieldLabel">Search</div>
                                            <input class="input" placeholder="Filter risks…" @bind="_riskQuery" @bind:event="oninput" />
                                        </label>
                                        <label class="field">
                                            <div class="fieldLabel">Severity</div>
                                            <select class="select selectCompact" @bind="_riskSeverityFilter">
                                                <option value="All">All</option>
                                                <option value="Low">Low</option>
                                                <option value="Medium">Medium</option>
                                                <option value="High">High</option>
                                            </select>
                                        </label>
                                        <label class="field">
                                            <div class="fieldLabel">Owner</div>
                                            <select class="select selectCompact" @bind="_riskOwnerFilter">
                                                <option value="All">All</option>
                                                @foreach (OwnerOption o in RiskOwnerOptions)
                                                {
                                                    <option value="@o.Id">@o.Name</option>
                                                }
                                            </select>
                                        </label>
                                    </div>
                                </section>
                                <section class="card subtle projectTabSection" aria-label="Linked risks">
                                    <div class="cardHeader"><div class="cardTitle">Linked Risks</div></div>
                                    <div class="projectTable projectRisksTable" role="table" aria-label="Project risks table">
                                        <div class="projectTableHeader projectRisksHeader" role="row">
                                            <div class="projectTh" role="columnheader">Severity</div>
                                            <div class="projectTh" role="columnheader">Risk</div>
                                            <div class="projectTh" role="columnheader">Owner</div>
                                        </div>
                                        @if (FilteredRisks.Count > 0)
                                        {
                                            @foreach (Risk r in FilteredRisks)
                                            {
                                                Guid riskId = r.Id;
                                                <button type="button" class="projectTableRow projectRisksRow projectTableRowBtn" role="row" title="Open risk in focus mode" @onclick="() => GoRisk(riskId)">
                                                    <div class="projectTd" role="cell">
                                                        <span class="pill @Tones.SeverityTone(r.Severity)">@r.Severity</span>
                                                    </div>
                                                    <div class="projectTd" role="cell">
                                                        <div class="projectCellTitle">@r.Title</div>
                                                        <div class="mutedSmall">@r.Description</div>
                                                    </div>
                                                    <div class="projectTd" role="cell">@FormatAssignee(r.OwnerId)</div>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="muted pad">No risks match your filters.</div>
                                        }
                                    </div>
                                </section>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>
