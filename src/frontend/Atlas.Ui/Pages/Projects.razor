@page "/projects"
@page "/projects/{ProjectId}"
@using Atlas.Ui.Components.Projects
<PageTitle>Projects — Atlas</PageTitle>

<div class="page pageFill">
    <PageTitleRow Title="Projects" AddLabel="Add project" AddingLabel="Adding…" Adding="_creating" OnAdd="HandleAddProject" />

    <div class="splitGrid splitGridFill @(IsFocusMode ? "projectsSplitFocus" : null)">
        @if (!IsFocusMode)
        {
            <section class="pane paneLeft" aria-label="Project list">
                <div class="list listCard">
                    @foreach (Project p in Cache.Projects)
                    {
                        Guid projectId = p.Id;
                        string projectName = p.Name;
                        string projectSummary = p.Summary;
                        <button @key="projectId"
                                type="button"
                                class="listRow listRowBtn @(projectId == Selection.SelectedProjectId ? "listRowActive" : null)"
                                @onclick="() => SelectFromList(projectId)"
                                @ondblclick="() => GoFocus(projectId)">
                            <div class="listMain">
                                <div class="listTitle">@projectName</div>
                                <div class="listMeta">@projectSummary</div>
                            </div>
                        </button>
                    }
                </div>
            </section>
        }

        <section class="pane paneCenter" aria-label="Project detail">
            @if (Selected is null)
            {
                <div class="card pad"><div class="muted">Select a project.</div></div>
            }
            else
            {
                <ProjectDetail Project="Selected"
                               IsFocusMode="IsFocusMode"
                               AutoEditId="_autoEditId"
                               AutoEditCleared="ClearAutoEdit"
                               OnEnterFocus="EnterFocus"
                               OnExitFocus="ExitFocus"
                               OnDeleted="OnProjectDeleted" />
            }
        </section>
    </div>
</div>
