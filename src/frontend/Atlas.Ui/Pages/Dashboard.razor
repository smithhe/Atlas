@page "/dashboard"
<PageTitle>Dashboard — Atlas</PageTitle>

<div class="page">
    <h2 class="pageTitle">Dashboard</h2>

    <div class="dashboardGrid">
        <section class="card">
            <header class="cardHeader">
                <div class="cardTitle">Attention Required</div>
                <div class="mutedSmall">Stale soon: @(this.StaleSoonDays)d • Stale: @(this.StaleDays)d</div>
            </header>
            <div class="list">
                <div class="dashboardGroup" data-testid="dashboard-needs-action">
                    <div class="dashboardGroupHeader">
                        <div class="dashboardGroupTitle">Needs Action</div>
                        <div class="mutedSmall">Things you should decide/unblock</div>
                    </div>
                    @if (this.NeedsAction.Count == 0)
                    {
                        <div class="dashboardEmpty">Nothing urgent right now.</div>
                    }
                    else
                    {
                        @foreach (DashRow row in this.NeedsAction)
                        {
                            <button @key="row.Key" class="listRow listRowBtn" type="button" @onclick="() => this.Go(row.To)">
                                <span class="dot @row.DotClass"></span>
                                <div class="listMain">
                                    <div class="listTitle">@row.Title</div>
                                    <div class="listMeta">@row.Meta</div>
                                </div>
                                @if (!string.IsNullOrEmpty(row.Pill))
                                {
                                    <div class="pill">@row.Pill</div>
                                }
                            </button>
                        }
                    }
                </div>

                <div class="dashboardGroup">
                    <div class="dashboardGroupHeader">
                        <div class="dashboardGroupTitle">Watchlist</div>
                        <div class="mutedSmall">Monitor — no immediate action</div>
                    </div>
                    @if (this.Watchlist.Count == 0)
                    {
                        <div class="dashboardEmpty">No watch items.</div>
                    }
                    else
                    {
                        @foreach (DashRow row in this.Watchlist)
                        {
                            <button @key="row.Key" class="listRow listRowBtn" type="button" @onclick="() => this.Go(row.To)">
                                <span class="dot @row.DotClass"></span>
                                <div class="listMain">
                                    <div class="listTitle">@row.Title</div>
                                    <div class="listMeta">@row.Meta</div>
                                </div>
                                @if (!string.IsNullOrEmpty(row.Pill))
                                {
                                    <div class="pill">@row.Pill</div>
                                }
                            </button>
                        }
                    }
                </div>
            </div>
        </section>

        <section class="card" data-testid="dashboard-commitment">
            <header class="cardHeader">
                <div class="cardTitle">Commitment View</div>
            </header>
            <div class="list">
                <div class="dashboardGroup">
                    <div class="dashboardGroupHeader">
                        <div class="dashboardGroupTitle">Today</div>
                        <div class="mutedSmall">Due today or recently-touched commitments</div>
                    </div>
                    @if (this.CommitmentToday.Count == 0)
                    {
                        <div class="dashboardEmpty">No items.</div>
                    }
                    else
                    {
                        @foreach (AtlasTask t in this.CommitmentToday)
                        {
                            <button @key="t.Id" class="listRow listRowBtn" type="button" @onclick="() => GoTask(t.Id)">
                                <span class="dot @PriorityDot(t.Priority)"></span>
                                <div class="listMain">
                                    <div class="listTitle">@t.Title</div>
                                    <div class="listMeta">@TaskWhy(t)</div>
                                </div>
                                <div class="pill">@CommitmentTodayPill(t)</div>
                            </button>
                        }
                    }
                </div>
                <div class="dashboardGroup">
                    <div class="dashboardGroupHeader">
                        <div class="dashboardGroupTitle">This Week</div>
                        <div class="mutedSmall">Due soon or medium-term commitments</div>
                    </div>
                    @if (this.CommitmentWeek.Count == 0)
                    {
                        <div class="dashboardEmpty">No items.</div>
                    }
                    else
                    {
                        @foreach (AtlasTask t in this.CommitmentWeek)
                        {
                            <button @key="t.Id" class="listRow listRowBtn" type="button" @onclick="() => GoTask(t.Id)">
                                <span class="dot @PriorityDot(t.Priority)"></span>
                                <div class="listMain">
                                    <div class="listTitle">@t.Title</div>
                                    <div class="listMeta">@TaskWhy(t)</div>
                                </div>
                                <div class="pill">@CommitmentWeekPill(t)</div>
                            </button>
                        }
                    }
                </div>
            </div>

            <div class="cardFooter">
                <button class="btn" type="button" @onclick="AskAiAttention">Ask AI: What needs my attention?</button>
            </div>
        </section>

        <section class="card">
            <header class="cardHeader">
                <div class="cardTitle">Team Pulse</div>
            </header>
            <div class="list">
                @if (this.TeamPulse.Count == 0)
                {
                    <div class="dashboardEmpty">
                        No team members imported yet.
                        <a class="crumbLink" href="/settings/azure-import">Import from Azure DevOps</a>.
                    </div>
                }
                else
                {
                    @foreach (TeamMember m in this.TeamPulse)
                    {
                        int? days = DisplayLabels.DaysSince(m.ActivitySnapshot.LastUpdatedIso);
                        string freshness = days is null ? "no update yet" : days > 7 ? "no update this week" : $"updated {days}d ago";
                        string freshnessTone = days is null ? "pillToneBad" : days > 7 ? "pillToneBad" : days >= 4 ? "pillToneWarn" : "pillToneOk";
                        <button @key="m.Id" class="listRow listRowBtn" type="button" @onclick="() => GoTeam(m.Id)">
                            <span class="dot dot-@(m.StatusDot.ToLowerInvariant())"></span>
                            <div class="listMain">
                                <div class="listTitle">@m.Name</div>
                                <div class="listMeta">@m.CurrentFocus</div>
                            </div>
                            <div class="pill @freshnessTone">@freshness</div>
                        </button>
                    }
                }
            </div>
        </section>

        <section class="card">
            <header class="cardHeader">
                <div class="cardTitle">Drift Signals</div>
                <div class="mutedSmall">Early warnings (not a backlog)</div>
            </header>
            <div class="list dashboardDriftList">
                @if (this.Drift.Count == 0)
                {
                    <div class="dashboardEmpty">No drift signals.</div>
                }
                else
                {
                    @foreach (DriftRow d in this.Drift)
                    {
                        <button @key="d.Key" class="listRow listRowBtn dashboardDriftRow" type="button" @onclick="() => this.Go(d.To)">
                            <span class="dot dot-stale"></span>
                            <div class="listMain">
                                <div class="listTitle">@d.Title</div>
                                <div class="listMeta">@d.Detail</div>
                            </div>
                            <div class="pill pillTag">@d.Tag</div>
                        </button>
                    }
                }
            </div>
        </section>
    </div>
</div>
