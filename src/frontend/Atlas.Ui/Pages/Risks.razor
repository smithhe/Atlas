@page "/risks"
@page "/risks/{RiskId}"
<PageTitle>Risks — Atlas</PageTitle>

<div class="page pageFill">
    <PageTitleRow Title="Risks & Mitigation" AddLabel="Add risk" AddingLabel="Adding…" Adding="_creating" OnAdd="HandleAddRisk" />

    <div class="risksStack @(IsFocusMode ? "risksStackFocus" : null) @(!ShowDetail ? "risksStackNoDetail" : null)">
        @if (!IsFocusMode)
        {
            <section class="card tight risksFiltersRow" aria-label="Risk filters">
                <label class="field">
                    <div class="fieldLabel">Status</div>
                    <select class="select selectCompact" value="@_statusFilter" @onchange="OnStatusFilterChange">
                        <option value="All">All</option>
                        <option value="Open">Open</option>
                        <option value="Watching">Watching</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                </label>

                <label class="field">
                    <div class="fieldLabel">Project</div>
                    <input class="input"
                           value="@_projectFilter"
                           @oninput="OnProjectFilterInput"
                           list="riskProjectFilterOptions"
                           placeholder="Type to filter…" />
                    <datalist id="riskProjectFilterOptions">
                        @foreach (string p in ProjectOptions)
                        {
                            <option value="@p"></option>
                        }
                    </datalist>
                </label>

                <label class="field">
                    <div class="fieldLabel">Severity</div>
                    <select class="select selectCompact" value="@_severityFilter" @onchange="OnSeverityFilterChange">
                        <option value="All">All</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </label>
            </section>
        }

        @if (!IsFocusMode)
        {
            <section class="list listCard risksListRow @(ShowDetail && Filtered.Count > 5 ? "risksListCapped" : null)"
                     aria-label="Risk list">
                @foreach (Risk r in Filtered)
                {
                    Guid riskId = r.Id;
                    int days = DisplayLabels.DaysSince(r.LastUpdatedIso) ?? 0;
                    <button type="button"
                            class="listRow listRowBtn risksRiskRow @(riskId == Selection.SelectedRiskId ? "listRowActive" : null)"
                            @onclick="() => SelectFromList(riskId)"
                            @ondblclick="() => GoFocus(riskId)">
                        <span class="dot dot-@r.Severity.ToLowerInvariant()" aria-hidden="true"></span>
                        <div class="listMain">
                            <div class="listTitle listTitleWrap">@r.Title</div>
                            <div class="listMeta">
                                @r.Status • last updated @days d@(string.IsNullOrEmpty(r.Project) ? "" : $" • {r.Project}")
                            </div>
                        </div>
                    </button>
                }
                @if (Filtered.Count == 0)
                {
                    <div class="muted pad">No risks match your filters.</div>
                }
            </section>
        }

        @if (ShowDetail)
        {
            <section class="risksDetailRow" aria-label="Risk detail editor">
                @if (Selected is null)
                {
                    <div class="card pad"><div class="muted">Risk not found.</div></div>
                }
                else
                {
                    Risk risk = Selected;
                    IReadOnlyList<AtlasTask> linkedTasks = GetLinkedTasks(risk);
                    IReadOnlyList<TeamMember> linkedMembers = GetLinkedMembers(risk);
                    IReadOnlyList<TeamMember> teamMemberOptions = Cache.Team.OrderBy(m => m.Name).ToList();
                    IReadOnlyList<RiskHistoryEntry> historyNewestFirst = risk.History
                        .OrderByDescending(h => h.CreatedIso)
                        .ToList();
                    RiskHistoryEntry? selectedHistory = _selectedHistoryId is null
                        ? null
                        : risk.History.FirstOrDefault(h => h.Id == _selectedHistoryId);

                    <div class="card pad riskDetailCard">
                        <div class="riskDetailHeader">
                            <div class="riskDetailHeaderTop">
                                <div class="riskDetailTitle">@(string.IsNullOrEmpty(risk.Title) ? "Risk Detail" : risk.Title)</div>
                                <div class="riskDetailHeaderRight">
                                    @if (!_editing)
                                    {
                                        <div class="pillRow">
                                            <span class="pill @Tones.RiskStatusTone(risk.Status)">@risk.Status</span>
                                            <span class="pill @Tones.SeverityTone(risk.Severity)">@risk.Severity</span>
                                        </div>
                                    }
                                    <div class="rowTiny">
                                        <button class="btn btnGhost" type="button" @onclick="ToggleEdit">@(_editing ? "Done" : "Edit")</button>
                                        <button class="btn btnGhost textBad" type="button" @onclick="HandleDelete" disabled="@_deleting">
                                            @(_deleting ? "Deleting…" : "Delete")
                                        </button>
                                        @if (IsFocusMode)
                                        {
                                            <button class="btn btnGhost" type="button" @onclick="ExitFocus">Exit focus</button>
                                        }
                                        else
                                        {
                                            <button class="btn btnGhost" type="button" @onclick="CloseDetail">Close</button>
                                            <button class="btn btnGhost" type="button" @onclick="EnterFocus">Focus</button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="mutedSmall">Last updated: @DisplayLabels.FormatDateTime(risk.LastUpdatedIso)</div>
                        </div>

                        <div class="fieldGrid2">
                            @if (_editing)
                            {
                                <label class="field span2">
                                    <div class="fieldLabel">Title</div>
                                    <input class="input" value="@risk.Title" @oninput="OnTitleInput" />
                                </label>

                                <label class="field">
                                    <div class="fieldLabel">Status</div>
                                    <select class="select" value="@risk.Status.ToString()" @onchange="OnStatusChange">
                                        <option value="Open">Open</option>
                                        <option value="Watching">Watching</option>
                                        <option value="Resolved">Resolved</option>
                                    </select>
                                </label>

                                <label class="field">
                                    <div class="fieldLabel">Severity</div>
                                    <select class="select" value="@risk.Severity" @onchange="OnSeverityChange">
                                        <option value="Low">Low</option>
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>
                                    </select>
                                </label>
                            }

                            <div class="field">
                                <div class="fieldLabel">Project</div>
                                @if (_editing)
                                {
                                    <select class="select" value="@(risk.Project ?? "")" @onchange="OnProjectChange">
                                        <option value="">(None)</option>
                                        @foreach (string p in ProjectOptions)
                                        {
                                            <option value="@p">@p</option>
                                        }
                                        @if (!string.IsNullOrEmpty(risk.Project) && !ProjectOptions.Contains(risk.Project))
                                        {
                                            <option value="@risk.Project">@risk.Project (custom)</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <div class="noteDetailReadonly">@(risk.Project ?? "—")</div>
                                }
                            </div>

                            <div class="field span2">
                                <div class="fieldLabel">Description</div>
                                @if (_editing)
                                {
                                    <textarea class="textarea" value="@risk.Description" @oninput="OnDescriptionInput"></textarea>
                                }
                                else
                                {
                                    <div class="riskDetailMarkdown riskDetailMarkdownBlock riskDetailDescriptionBlock">
                                        @if (string.IsNullOrWhiteSpace(risk.Description))
                                        {
                                            <div class="muted">—</div>
                                        }
                                        else
                                        {
                                            <MarkdownBlock Text="@risk.Description" />
                                        }
                                    </div>
                                }
                            </div>

                            <div class="field span2">
                                <div class="fieldLabel">Evidence / Examples</div>
                                @if (_editing)
                                {
                                    <textarea class="textarea" value="@risk.Evidence" @oninput="OnEvidenceInput"></textarea>
                                }
                                else
                                {
                                    <div class="riskDetailMarkdown riskDetailMarkdownBlock riskDetailEvidenceBlock">
                                        @if (string.IsNullOrWhiteSpace(risk.Evidence))
                                        {
                                            <div class="muted">—</div>
                                        }
                                        else
                                        {
                                            <MarkdownBlock Text="@risk.Evidence" />
                                        }
                                    </div>
                                }
                            </div>

                            <div class="field span2">
                                <div class="risksLinkedGrid">
                                    <div class="field">
                                        <div class="fieldLabel">Linked Tasks</div>
                                        <div class="list listCard risksLinkedListCard">
                                            @if (linkedTasks.Count == 0)
                                            {
                                                <div class="muted pad">No linked tasks yet.</div>
                                            }
                                            else
                                            {
                                                @foreach (AtlasTask t in linkedTasks)
                                                {
                                                    <button type="button" class="listRow listRowBtn" @onclick="() => GoTask(t.Id)">
                                                        <span class="dot dot-@t.Priority.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                                                        <div class="listMain">
                                                            <div class="listTitle">@t.Title</div>
                                                            <div class="listMeta">
                                                                @t.Priority
                                                                @if (!string.IsNullOrEmpty(t.Project)) { <text> • @t.Project</text> }
                                                                @if (!string.IsNullOrEmpty(t.DueDate)) { <text> • Due @t.DueDate</text> }
                                                            </div>
                                                        </div>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <div class="field">
                                        <div class="fieldLabel">Linked Team Members</div>
                                        @if (_editing)
                                        {
                                            <div class="list listCard risksLinkedListCard">
                                                @if (teamMemberOptions.Count == 0)
                                                {
                                                    <div class="muted pad">
                                                        Import team members from Azure DevOps first (
                                                        <a class="crumbLink" href="/settings/azure-import">Settings → Azure Import</a>
                                                        ).
                                                    </div>
                                                }
                                                else
                                                {
                                                    @foreach (TeamMember m in teamMemberOptions)
                                                    {
                                                        bool linked = risk.LinkedTeamMemberIds.Contains(m.Id);
                                                        <label class="listRow" style="cursor: pointer">
                                                            <input type="checkbox"
                                                                   checked="@linked"
                                                                   @onchange="e => OnTeamMemberToggle(m.Id, e)" />
                                                            <span class="dot dot-@m.StatusDot.ToLowerInvariant()" aria-hidden="true"></span>
                                                            <div class="listMain">
                                                                <div class="listTitle">@m.Name</div>
                                                                <div class="listMeta">
                                                                    @(m.Role ?? "Team member")@(string.IsNullOrEmpty(m.CurrentFocus) ? "" : $" • {m.CurrentFocus}")
                                                                </div>
                                                            </div>
                                                        </label>
                                                    }
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="list listCard risksLinkedListCard">
                                                @if (linkedMembers.Count == 0)
                                                {
                                                    <div class="muted pad">No linked team members yet.</div>
                                                }
                                                else
                                                {
                                                    @foreach (TeamMember m in linkedMembers)
                                                    {
                                                        <button type="button" class="listRow listRowBtn" @onclick="() => GoTeamMember(m.Id)">
                                                            <span class="dot dot-@m.StatusDot.ToLowerInvariant()" aria-hidden="true"></span>
                                                            <div class="listMain">
                                                                <div class="listTitle">@m.Name</div>
                                                                <div class="listMeta">
                                                                    @(m.Role ?? "Team member")@(string.IsNullOrEmpty(m.CurrentFocus) ? "" : $" • {m.CurrentFocus}")
                                                                </div>
                                                            </div>
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="field span2">
                                <div class="fieldLabel">Notes / History</div>
                                <div class="row mt-sm">
                                    <button class="btn btnSecondary" type="button" @onclick="ToggleAddingNote">
                                        @(_isAddingNote ? "Cancel" : "Add note")
                                    </button>
                                </div>

                                @if (_isAddingNote)
                                {
                                    <div class="mt-sm">
                                        <label class="field">
                                            <div class="fieldLabel">New note</div>
                                            <textarea class="textarea"
                                                      placeholder="Write a note (Markdown supported)…"
                                                      value="@_newNoteText"
                                                      @oninput="OnNewNoteInput"></textarea>
                                        </label>
                                        <div class="row mt-sm">
                                            <button class="btn btnSecondary" type="button" @onclick="AddNote">Add</button>
                                        </div>
                                    </div>
                                }

                                <div class="mt-md">
                                    @if (historyNewestFirst.Count == 0)
                                    {
                                        <div class="muted">No history yet.</div>
                                    }
                                    else
                                    {
                                        <div class="list listCard">
                                            @foreach (RiskHistoryEntry h in historyNewestFirst)
                                            {
                                                Guid historyId = h.Id;
                                                <button type="button"
                                                        class="listRow listRowBtn"
                                                        @onclick="() => OpenHistoryNote(historyId, h.Text)">
                                                    <div class="listMain">
                                                        <div class="listMeta">@DisplayLabels.FormatDateTime(h.CreatedIso)</div>
                                                        <div class="noteBody mt-sm">
                                                            <MarkdownBlock Text="@h.Text" />
                                                        </div>
                                                    </div>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <AtlasModal Title="Note"
                                IsOpen="@(selectedHistory is not null)"
                                OnClose="CloseHistoryNote">
                        <ChildContent>
                            @if (selectedHistory is not null)
                            {
                                <div class="noteMeta">
                                    <span class="mutedSmall">@DisplayLabels.FormatDateTime(selectedHistory.CreatedIso)</span>
                                    <span class="chip chipGhost">Risk history</span>
                                </div>

                                <div class="noteEdit">
                                    <div class="noteEditTabs">
                                        <button type="button"
                                                class="btn btnGhost @(_historyEditTab == "Write" ? "noteEditTabActive" : null)"
                                                @onclick='() => _historyEditTab = "Write"'>
                                            Write
                                        </button>
                                        <button type="button"
                                                class="btn btnGhost @(_historyEditTab == "Preview" ? "noteEditTabActive" : null)"
                                                @onclick='() => _historyEditTab = "Preview"'>
                                            Preview
                                        </button>
                                    </div>

                                    @if (_historyEditTab == "Write")
                                    {
                                        <textarea class="textarea textareaAutoGrow noteEditTextarea"
                                                  value="@_historyDraftText"
                                                  @oninput="OnHistoryDraftInput"></textarea>
                                    }
                                    else
                                    {
                                        <div class="noteText noteBody">
                                            <MarkdownBlock Text="@_historyDraftText" />
                                        </div>
                                    }
                                </div>
                            }
                        </ChildContent>
                        <Footer>
                            @if (selectedHistory is not null)
                            {
                                <div class="row mt-0">
                                    <button class="btn btnSecondary" type="button" @onclick="SaveHistoryNote">Save</button>
                                    <button class="btn btnGhost" type="button" @onclick="CloseHistoryNote">Cancel</button>
                                </div>
                            }
                        </Footer>
                    </AtlasModal>
                }
            </section>
        }
    </div>
</div>
