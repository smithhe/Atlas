@page "/risks"
@page "/risks/{RiskId}"
@using Atlas.Ui.Components.Risks
<PageTitle>Risks — Atlas</PageTitle>

<div class="page pageFill">
    <PageTitleRow Title="Risks & Mitigation" AddLabel="Add risk" AddingLabel="Adding…" Adding="this.Creating" OnAdd="this.HandleAddRisk" />

    <div class="risksStack @(this.IsFocusMode ? "risksStackFocus" : null) @(!this.ShowDetail ? "risksStackNoDetail" : null)">
        @if (!this.IsFocusMode)
        {
            <section class="card tight risksFiltersRow" aria-label="Risk filters">
                <label class="field">
                    <div class="fieldLabel">Status</div>
                    <select class="select selectCompact" value="@this.StatusFilter" @onchange="this.OnStatusFilterChange">
                        <option value="All">All</option>
                        <option value="Open">Open</option>
                        <option value="Watching">Watching</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                </label>

                <label class="field">
                    <div class="fieldLabel">Project</div>
                    <input class="input"
                           value="@this.ProjectFilter"
                           @oninput="this.OnProjectFilterInput"
                           list="riskProjectFilterOptions"
                           placeholder="Type to filter…" />
                    <datalist id="riskProjectFilterOptions">
                        @foreach (string p in this.ProjectOptions)
                        {
                            <option value="@p"></option>
                        }
                    </datalist>
                </label>

                <label class="field">
                    <div class="fieldLabel">Severity</div>
                    <select class="select selectCompact" value="@this.SeverityFilter" @onchange="this.OnSeverityFilterChange">
                        <option value="All">All</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </label>
            </section>
        }

        @if (!this.IsFocusMode)
        {
            <section class="list listCard risksListRow @(this.ShowDetail && Filtered.Count > 5 ? "risksListCapped" : null)"
                     aria-label="Risk list">
                @foreach (Risk r in Filtered)
                {
                    Guid riskId = r.Id;
                    int days = DisplayLabels.DaysSince(r.LastUpdatedIso) ?? 0;
                    <button @key="riskId"
                            type="button"
                            class="listRow listRowBtn risksRiskRow @(riskId == this._selection.SelectedRiskId ? "listRowActive" : null)"
                            @onclick="() => SelectFromList(riskId)"
                            @ondblclick="() => GoFocus(riskId)">
                        <span class="dot dot-@r.Severity.ToLowerInvariant()" aria-hidden="true"></span>
                        <div class="listMain">
                            <div class="listTitle listTitleWrap">@r.Title</div>
                            <div class="listMeta">
                                @r.Status • last updated @days d@(string.IsNullOrEmpty(r.Project) ? "" : $" • {r.Project}")
                            </div>
                        </div>
                    </button>
                }
                @if (Filtered.Count == 0)
                {
                    <div class="muted pad">No risks match your filters.</div>
                }
            </section>
        }

        @if (this.ShowDetail)
        {
            <RiskDetail Risk="this.Selected"
                        IsFocusMode="this.IsFocusMode"
                        AutoEditId="this.AutoEditId"
                        AutoEditCleared="this.ClearAutoEdit"
                        OnClose="this.CloseDetail"
                        OnEnterFocus="this.EnterFocus"
                        OnExitFocus="this.ExitFocus"
                        OnDeleted="this.OnRiskDeleted" />
        }
    </div>
</div>
