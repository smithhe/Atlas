@page "/risks"
@page "/risks/{RiskId}"
@using Atlas.Ui.Components.Risks
<PageTitle>Risks — Atlas</PageTitle>

<div class="page pageFill">
    <PageTitleRow Title="Risks & Mitigation" AddLabel="Add risk" AddingLabel="Adding…" Adding="_creating" OnAdd="HandleAddRisk" />

    <div class="risksStack @(IsFocusMode ? "risksStackFocus" : null) @(!ShowDetail ? "risksStackNoDetail" : null)">
        @if (!IsFocusMode)
        {
            <section class="card tight risksFiltersRow" aria-label="Risk filters">
                <label class="field">
                    <div class="fieldLabel">Status</div>
                    <select class="select selectCompact" value="@_statusFilter" @onchange="OnStatusFilterChange">
                        <option value="All">All</option>
                        <option value="Open">Open</option>
                        <option value="Watching">Watching</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                </label>

                <label class="field">
                    <div class="fieldLabel">Project</div>
                    <input class="input"
                           value="@_projectFilter"
                           @oninput="OnProjectFilterInput"
                           list="riskProjectFilterOptions"
                           placeholder="Type to filter…" />
                    <datalist id="riskProjectFilterOptions">
                        @foreach (string p in ProjectOptions)
                        {
                            <option value="@p"></option>
                        }
                    </datalist>
                </label>

                <label class="field">
                    <div class="fieldLabel">Severity</div>
                    <select class="select selectCompact" value="@_severityFilter" @onchange="OnSeverityFilterChange">
                        <option value="All">All</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </label>
            </section>
        }

        @if (!IsFocusMode)
        {
            <section class="list listCard risksListRow @(ShowDetail && Filtered.Count > 5 ? "risksListCapped" : null)"
                     aria-label="Risk list">
                @foreach (Risk r in Filtered)
                {
                    Guid riskId = r.Id;
                    int days = DisplayLabels.DaysSince(r.LastUpdatedIso) ?? 0;
                    <button @key="riskId"
                            type="button"
                            class="listRow listRowBtn risksRiskRow @(riskId == Selection.SelectedRiskId ? "listRowActive" : null)"
                            @onclick="() => SelectFromList(riskId)"
                            @ondblclick="() => GoFocus(riskId)">
                        <span class="dot dot-@r.Severity.ToLowerInvariant()" aria-hidden="true"></span>
                        <div class="listMain">
                            <div class="listTitle listTitleWrap">@r.Title</div>
                            <div class="listMeta">
                                @r.Status • last updated @days d@(string.IsNullOrEmpty(r.Project) ? "" : $" • {r.Project}")
                            </div>
                        </div>
                    </button>
                }
                @if (Filtered.Count == 0)
                {
                    <div class="muted pad">No risks match your filters.</div>
                }
            </section>
        }

        @if (ShowDetail)
        {
            <RiskDetail Risk="Selected"
                        IsFocusMode="IsFocusMode"
                        AutoEditId="_autoEditId"
                        AutoEditCleared="ClearAutoEdit"
                        OnClose="CloseDetail"
                        OnEnterFocus="EnterFocus"
                        OnExitFocus="ExitFocus"
                        OnDeleted="OnRiskDeleted" />
        }
    </div>
</div>
