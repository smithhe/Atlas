@page "/tasks"
@page "/tasks/{TaskId}"
@using Atlas.Ui.Components.Tasks
<PageTitle>Tasks — Atlas</PageTitle>

<div class="page pageFill">
    <PageTitleRow Title="Tasks" AddLabel="Add task" AddingLabel="Adding…" Adding="this.Creating" OnAdd="this.HandleAddTask" />

    <div class="tasksStack @(this.IsFocusMode ? "tasksStackFocus" : null) @(!this.ShowDetail ? "tasksStackNoDetail" : null)">
        @if (!this.IsFocusMode)
        {
            <section class="card tight tasksFiltersRow" aria-label="Task filters">
                <label class="field">
                    <div class="fieldLabel">Project</div>
                    <div class="fieldInline">
                        <select class="select selectCompact" value="@this.ProjectFilter" @onchange="this.OnProjectFilterChange">
                            <option value="All">All</option>
                            <option value="">(None)</option>
                            @foreach (Project p in this.ProjectOptions)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                        <button type="button" class="btn btnGhost btnIcon" title="Sort by Project" @onclick='() => this.ToggleSort("Project")'>
                            @this.SortButtonGlyph("Project")
                        </button>
                    </div>
                </label>

                <label class="field">
                    <div class="fieldLabel">Risk</div>
                    <div class="fieldInline">
                        <select class="select selectCompact" value="@this.RiskFilter" @onchange="this.OnRiskFilterChange">
                            <option value="All">All</option>
                            <option value="">(None)</option>
                            @foreach (Risk r in this.RiskOptions)
                            {
                                <option value="@r.Id">@r.Title</option>
                            }
                        </select>
                        <button type="button" class="btn btnGhost btnIcon" title="Sort by Risk" @onclick='() => this.ToggleSort("Risk")'>
                            @this.SortButtonGlyph("Risk")
                        </button>
                    </div>
                </label>

                <label class="field">
                    <div class="fieldLabel">Priority</div>
                    <div class="fieldInline">
                        <select class="select selectCompact" value="@this.PriorityFilter" @onchange="this.OnPriorityFilterChange">
                            <option value="All">All</option>
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical</option>
                        </select>
                        <button type="button" class="btn btnGhost btnIcon" title="Sort by Priority" @onclick='() => this.ToggleSort("Priority")'>
                            @this.SortButtonGlyph("Priority")
                        </button>
                    </div>
                </label>

                <label class="field">
                    <div class="fieldLabel">Status</div>
                    <div class="fieldInline">
                        <select class="select selectCompact" value="@this.StatusFilter" @onchange="this.OnStatusFilterChange">
                            <option value="All">All</option>
                            <option value="Not Started">Not Started</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Blocked">Blocked</option>
                            <option value="Done">Done</option>
                        </select>
                    </div>
                </label>

                <label class="field">
                    <div class="fieldLabel">Staleness</div>
                    <div class="fieldInline">
                        <select class="select selectCompact" value="@this.StalenessFilter" @onchange="this.OnStalenessFilterChange">
                            <option value="All">All</option>
                            <option value="Fresh">Fresh</option>
                            <option value="Warning">Getting close</option>
                            <option value="Stale">Stale</option>
                        </select>
                        <button type="button" class="btn btnGhost btnIcon" title="Sort by Staleness" @onclick='() => this.ToggleSort("Staleness")'>
                            @this.SortButtonGlyph("Staleness")
                        </button>
                    </div>
                </label>

                <label class="field">
                    <div class="fieldLabel">Est. Duration</div>
                    <div class="fieldInline">
                        <select class="select selectCompact" value="@this.DurationFilter" @onchange="this.OnDurationFilterChange">
                            <option value="All">All</option>
                            <option value="&lt;=30m">≤ 30m</option>
                            <option value="&lt;=2h">≤ 2h</option>
                            <option value="&lt;=4h">≤ 4h</option>
                            <option value="&lt;=1d">≤ 1d</option>
                            <option value="&gt;1d">&gt; 1d</option>
                            <option value="Invalid">Invalid</option>
                        </select>
                        <button type="button" class="btn btnGhost btnIcon" title="Sort by Estimated Duration" @onclick='() => this.ToggleSort("Estimated Duration")'>
                            @this.SortButtonGlyph("Estimated Duration")
                        </button>
                    </div>
                </label>
            </section>
        }

        @if (!this.IsFocusMode)
        {
            <section class="list listCard tasksListRow @(this.ShowDetail && this.FilteredSorted.Count > 5 ? "tasksListCapped" : null)"
                     aria-label="Task list">
                @foreach (AtlasTask t in this.FilteredSorted)
                {
                    Guid taskId = t.Id;
                    string statusLabel = DisplayLabels.FormatTaskStatus(t.Status);
                    int days = DisplayLabels.DaysSince(t.LastTouchedIso) ?? 0;
                    string activity = this.ActivityColor(days);
                    int depCount = BlockedByCount(t);
                    <button @key="taskId"
                            type="button"
                            class="listRow listRowBtn tasksTaskRow @(taskId == this._selection.SelectedTaskId ? "listRowActive" : null)"
                            @onclick="() => SelectFromList(taskId)"
                            @ondblclick="() => GoFocus(taskId)">
                        <div class="listMain">
                            <div class="listTitle listTitleWrap">@t.Title</div>
                            <div class="listMeta listMetaWrap">
                                @if (!string.IsNullOrEmpty(t.Project)) { <text> • @t.Project</text> }
                                @if (!string.IsNullOrEmpty(t.Risk)) { <text> • Risk: @t.Risk</text> }
                                @if (depCount > 0) { <text> • Blocked by @depCount</text> }
                            </div>
                            <div class="listMeta listMetaWrap">
                                @(string.IsNullOrEmpty(t.DueDate) ? " " : $"Due {t.DueDate}")
                            </div>
                        </div>
                        <div class="pillRow tasksTaskRowPills">
                            <div class="pill">@ListDurationPill(t.EstimatedDurationText)</div>
                            <div class="pill @Tones.TaskStatusTone(t.Status)">@statusLabel</div>
                            <div class="pill @Tones.PriorityTone(t.Priority)">@t.Priority</div>
                            <span class="activityDot activityDot-@activity"
                                  title="Activity: @days d ago (stale threshold @this.StaleDays d)"
                                  aria-label="Activity: @days days ago"></span>
                        </div>
                    </button>
                }
                @if (this.FilteredSorted.Count == 0)
                {
                    <div class="muted pad">No tasks match your filters.</div>
                }
            </section>
        }

        @if (this.ShowDetail)
        {
            <TaskDetail Task="this.Selected"
                        IsFocusMode="this.IsFocusMode"
                        AutoEditId="this.AutoEditId"
                        AutoEditCleared="ClearAutoEdit"
                        OnClose="CloseDetail"
                        OnEnterFocus="EnterFocus"
                        OnExitFocus="ExitFocus"
                        OnDeleted="OnTaskDeleted" />
        }
    </div>
</div>
