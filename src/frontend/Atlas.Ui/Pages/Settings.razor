@page "/settings"
<PageTitle>Settings — Atlas</PageTitle>

<div class="page">
    <h2 class="pageTitle">Settings</h2>

    @if (Cache.Settings is null)
    {
        <div class="muted">Loading settings…</div>
    }
    else
    {
        <div class="card pad">
            <div class="fieldGrid2">
                <label class="field">
                    <div class="fieldLabel">Stale threshold (days)</div>
                    <input class="input"
                           type="number"
                           min="1"
                           data-testid="settings-stale-days"
                           aria-label="Stale threshold (days)"
                           value="@_staleDays"
                           @oninput="OnStaleDaysInput" />
                </label>

                <label class="field">
                    <div class="fieldLabel">Theme</div>
                    <input class="input" value="Dark (locked)" readonly />
                    <div class="mutedSmall">Light theme is not available in v1.</div>
                </label>

                <label class="field span2">
                    <div class="fieldLabel">Default AI behavior</div>
                    <div class="placeholderBox">Manual only (AI acts only when you click an action)</div>
                </label>

                <label class="field span2">
                    <div class="fieldLabel">Default AI chat panel state on app open</div>
                    <select class="input" value="@(_aiPanelOpen ? "on" : "off")" @onchange="OnAiPanelChange">
                        <option value="off">Off (closed)</option>
                        <option value="on">On (open)</option>
                    </select>
                    <div class="mutedSmall">Saved in this browser only (localStorage), not with Save settings.</div>
                </label>

                <label class="field span2">
                    <div class="fieldLabel">Keyboard shortcuts cheat sheet</div>
                    <div class="placeholderBox">- Tab / Shift+Tab: move focus
- Enter: activate buttons
- Top bar search: find tasks, risks, people, and projects
- Quick Add: create a task, risk, or team note from any main view</div>
                </label>

                <label class="field span2">
                    <div class="fieldLabel">Azure DevOps base URL</div>
                    <input class="input" value="@_azureBaseUrl" @oninput="OnAzureBaseUrlInput" />
                </label>
            </div>

            <div class="row mt-lg">
                <button class="btn" type="button" @onclick="SaveSettings" disabled="@_saving" aria-busy="@(_saving ? true : null)">
                    <span class="btnContent">
                        @if (_saving)
                        {
                            <span class="spinner spinner-sm spinnerInline" role="status" aria-label="Saving settings"></span>
                        }
                        <span class="btnLabel">Save settings</span>
                    </span>
                </button>
                @if (!string.IsNullOrEmpty(_settingsError))
                {
                    <div class="muted" style="margin-left: 12px">@_settingsError</div>
                }
            </div>
        </div>

        <div class="card pad mt-lg">
            <div class="loadingOverlayWrap @(_azureLoading ? "loadingOverlayWrapActive" : null)">
                <div class="loadingOverlayBody">
                    <div class="rowTiny items-center mb-sm">
                        <h3 style="margin: 0">Azure DevOps</h3>
                    </div>
                    <div class="fieldGrid2">
                        <label class="field">
                            <div class="fieldLabel">Organization</div>
                            <input class="input" @bind="_org" @bind:event="oninput" />
                        </label>
                        <label class="field">
                            <div class="fieldLabel">Project</div>
                            <input class="input" @bind="_project" @bind:event="oninput" />
                        </label>
                        <label class="field">
                            <div class="fieldLabel">Area path</div>
                            <input class="input" @bind="_areaPath" @bind:event="oninput" />
                        </label>
                        <label class="field">
                            <div class="fieldLabel">Team (optional)</div>
                            <input class="input" @bind="_teamName" @bind:event="oninput" />
                        </label>
                        <label class="field">
                            <div class="fieldLabel">Project ID</div>
                            <input class="input" @bind="_projectId" @bind:event="oninput" />
                        </label>
                        <label class="field">
                            <div class="fieldLabel">Team ID</div>
                            <input class="input" @bind="_teamId" @bind:event="oninput" />
                        </label>
                        <label class="field">
                            <div class="fieldLabel">Enabled</div>
                            <select class="input" @bind="_enabledYesNo">
                                <option value="yes">Yes</option>
                                <option value="no">No</option>
                            </select>
                        </label>
                    </div>

                    <div class="rowTiny mt-lg items-center">
                        <button class="btn btnWide"
                                type="button"
                                @onclick="SaveAzureConnection"
                                disabled="@(!_azureLoaded || _azureSaving || string.IsNullOrWhiteSpace(_projectId) || string.IsNullOrWhiteSpace(_teamId))"
                                aria-busy="@(_azureSaving ? true : null)">
                            <span class="btnContent">
                                @if (_azureSaving)
                                {
                                    <span class="spinner spinner-sm spinnerInline" role="status" aria-label="Saving Azure DevOps connection"></span>
                                }
                                <span class="btnLabel">Save Azure connection</span>
                            </span>
                        </button>
                        <button class="btn btnSecondary btnWide"
                                type="button"
                                @onclick="SyncNow"
                                disabled="@(!_azureLoaded || SyncInProgress)"
                                aria-busy="@(_syncRunning ? true : null)">
                            <span class="btnContent">
                                @if (_syncRunning)
                                {
                                    <span class="spinner spinner-sm spinnerInline" role="status" aria-label="Syncing…"></span>
                                }
                                <span class="btnLabel">@(SyncInProgress ? "Syncing…" : "Sync now")</span>
                            </span>
                        </button>
                        <button class="btn btnSecondary btnWide" type="button" @onclick="OpenAzureImport">
                            Open Azure Import
                        </button>
                    </div>
                    @if (_azureLoaded && (string.IsNullOrWhiteSpace(_projectId) || string.IsNullOrWhiteSpace(_teamId)))
                    {
                        <div class="mutedSmall textBad mt-sm">
                            Azure connection needs Project ID and Team ID. Use <NavLink href="/setup">Azure Setup</NavLink>.
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_azureError))
                    {
                        <div class="mutedSmall textBad mt-xs">@_azureError</div>
                    }
                    @if (!string.IsNullOrEmpty(_azureSyncMessage))
                    {
                        <div class="mutedSmall mt-xs">@_azureSyncMessage</div>
                    }

                    <div class="loadingOverlayWrap @(_syncStateLoading ? "loadingOverlayWrapActive" : null)">
                        <div class="loadingOverlayBody">
                            @if (_syncState is not null)
                            {
                                <div class="muted mt-md">
                                    @if (SyncInProgress)
                                    {
                                        <span class="textWarn">Syncing…</span>
                                    }
                                    else
                                    {
                                        <text>Last sync: @LastCompletedLabel</text>
                                        @if (LastAttemptedLabel is not null)
                                        {
                                            <text> · Last attempt: @LastAttemptedLabel</text>
                                        }
                                        <text> · Status: </text>
                                        <span class="@SyncStatusClass(_syncState.LastRunStatus)">@_syncState.LastRunStatus</span>
                                        @if (!string.IsNullOrEmpty(_syncState.LastError))
                                        {
                                            <text> · </text>
                                            <span class="textBad">Error: @_syncState.LastError</span>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="muted mt-md">No sync history yet.</div>
                            }
                        </div>
                        @if (_syncStateLoading)
                        {
                            <div class="loadingOverlay" role="presentation">
                                <span class="spinner spinner-sm" role="status" aria-label="Loading sync history"></span>
                            </div>
                        }
                    </div>
                </div>
                @if (_azureLoading)
                {
                    <div class="loadingOverlay" role="presentation">
                        <span class="spinner spinner-md" role="status" aria-label="Loading Azure DevOps connection"></span>
                    </div>
                }
            </div>
        </div>
    }
</div>
