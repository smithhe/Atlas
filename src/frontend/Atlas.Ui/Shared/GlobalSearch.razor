<div class="globalSearch" @onkeydown="OnRootKeyDown">
    <input class="searchInput"
           role="combobox"
           aria-label="Search"
           aria-autocomplete="list"
           aria-haspopup="listbox"
           aria-expanded="@(_open && HasQuery ? "true" : "false")"
           aria-controls="@(_open && HasQuery ? "atlas-search-results" : null)"
           aria-activedescendant="@(_open && HasQuery && _results.Count > 0 ? $"atlas-search-results-{_active}" : null)"
           placeholder="Search tasks, risks, people, projects…"
           disabled="@Cache.IsHydrating"
           value="@_query"
           @oninput="OnQueryInput"
           @onfocus="() => _open = true"
           @onkeydown="OnKeyDown" />
    @if (_open && HasQuery)
    {
        <div class="searchResults list listCard" id="atlas-search-results" role="listbox" aria-label="Search results">
            @if (_results.Count == 0)
            {
                <div class="searchResultsEmpty muted">No matches</div>
            }
            else
            {
                @for (var i = 0; i < _results.Count; i++)
                {
                    int idx = i;
                    SearchResult result = _results[i];
                    <button type="button"
                            id="@($"atlas-search-results-{idx}")"
                            role="option"
                            aria-selected="@(idx == _active)"
                            class="listRow listRowBtn searchResultRow @(idx == _active ? "listRowActive" : null)"
                            @onmouseenter="() => _active = idx"
                            @onclick="() => SelectResult(result)">
                        <div class="listMain">
                            <div class="listTitle">@result.Title</div>
                            <div class="listMeta">@(string.IsNullOrEmpty(result.Meta) ? result.Kind : result.Meta)</div>
                        </div>
                        <span class="pill searchResultKind">@result.Kind</span>
                    </button>
                }
            }
        </div>
    }
</div>
