<div class="globalSearch" @onkeydown="this.OnRootKeyDown">
    <input class="searchInput"
           role="combobox"
           aria-label="Search"
           aria-autocomplete="list"
           aria-haspopup="listbox"
           aria-expanded="@(this.Open && HasQuery ? "true" : "false")"
           aria-controls="@(this.Open && HasQuery ? "atlas-search-results" : null)"
           aria-activedescendant="@(this.Open && HasQuery && this.Results.Count > 0 ? $"atlas-search-results-{this.Active}" : null)"
           placeholder="Search tasks, risks, people, projects…"
           disabled="@this._cache.IsHydrating"
           value="@this.Query"
           @oninput="this.OnQueryInput"
           @onfocus="() => this.Open = true"
           @onkeydown="this.OnKeyDown" />
    @if (this.Open && HasQuery)
    {
        <div class="searchResults list listCard" id="atlas-search-results" role="listbox" aria-label="Search results">
            @if (this.Results.Count == 0)
            {
                <div class="searchResultsEmpty muted">No matches</div>
            }
            else
            {
                @for (var i = 0; i < this.Results.Count; i++)
                {
                    int idx = i;
                    SearchResult result = this.Results[i];
                    <button type="button"
                            id="@($"atlas-search-results-{idx}")"
                            role="option"
                            aria-selected="@(idx == this.Active)"
                            class="listRow listRowBtn searchResultRow @(idx == this.Active ? "listRowActive" : null)"
                            @onmouseenter="() => this.Active = idx"
                            @onclick="() => SelectResult(result)">
                        <div class="listMain">
                            <div class="listTitle">@result.Title</div>
                            <div class="listMeta">@(string.IsNullOrEmpty(result.Meta) ? result.Kind : result.Meta)</div>
                        </div>
                        <span class="pill searchResultKind">@result.Kind</span>
                    </button>
                }
            }
        </div>
    }
</div>
