@if (IsOpen)
{
    <div class="modalOverlay" role="presentation" @onmousedown="this.CloseFromOverlay" @onkeydown="this.OnOverlayKey">
        <div class="modalPanel"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@this._titleId"
             tabindex="-1"
             @onmousedown:stopPropagation="true"
             @ref="this.Panel">
            <div class="modalHeader">
                <div class="modalTitle" id="@this._titleId">@this.Title</div>
                <button class="btn btnGhost" type="button" @onclick="this.HandleClose">Close</button>
            </div>
            <div class="modalBody">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="modalFooter">@Footer</div>
            }
        </div>
    </div>
}
