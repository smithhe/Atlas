# Classic builder works if BuildKit overlay fails: DOCKER_BUILDKIT=0 COMPOSE_BAKE=false
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Keep Api/Core/Infrastructure layout (project references use ..\..\..) but avoid
# nesting under /src/src/backend/... which can trigger MSB3552 (**/*.resx as literal).
COPY src/Directory.Build.props ./
COPY src/backend/Api/Atlas.Api/Atlas.Api.csproj Api/Atlas.Api/
COPY src/backend/Core/Atlas.Application/Atlas.Application.csproj Core/Atlas.Application/
COPY src/backend/Core/Atlas.Domain/Atlas.Domain.csproj Core/Atlas.Domain/
COPY src/backend/Infrastructure/Atlas.Persistence/Atlas.Persistence.csproj Infrastructure/Atlas.Persistence/
COPY src/backend/Infrastructure/Atlas.AzureDevOps/Atlas.AzureDevOps.csproj Infrastructure/Atlas.AzureDevOps/

RUN dotnet restore Api/Atlas.Api/Atlas.Api.csproj

COPY src/backend/Api/Atlas.Api/ Api/Atlas.Api/
COPY src/backend/Core/Atlas.Application/ Core/Atlas.Application/
COPY src/backend/Core/Atlas.Domain/ Core/Atlas.Domain/
COPY src/backend/Infrastructure/Atlas.Persistence/ Infrastructure/Atlas.Persistence/
COPY src/backend/Infrastructure/Atlas.AzureDevOps/ Infrastructure/Atlas.AzureDevOps/

RUN dotnet publish Api/Atlas.Api/Atlas.Api.csproj \
    -c Release \
    -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=5 \
  CMD curl -fsS http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "Atlas.Api.dll"]
