# Classic builder works if BuildKit overlay fails: DOCKER_BUILDKIT=0 COMPOSE_BAKE=false
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/frontend/Atlas.Ui/ Atlas.Ui/
WORKDIR /src/Atlas.Ui

RUN dotnet restore Atlas.Ui.csproj
RUN dotnet publish Atlas.Ui.csproj -c Release -o /app/publish --no-restore

ARG API_BASE_URL=http://localhost:5012
RUN printf '{\n  "ApiBaseUrl": "%s"\n}\n' "$API_BASE_URL" > /app/publish/wwwroot/appsettings.json \
    && rm -f /app/publish/wwwroot/appsettings.json.gz /app/publish/wwwroot/appsettings.json.br

FROM nginx:1.27-alpine AS final
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html

EXPOSE 80
